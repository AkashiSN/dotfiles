{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],
  "ignorePresets": ["group:monorepos"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-8 * * 1"],
  "customDatasources": {
    "kiro": {
      "defaultRegistryUrlTemplate": "https://prod.download.cli.kiro.dev/stable/latest/manifest.json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    }
  },
  "customManagers": [
    {
      "description": "aqua の Kiro CLI（local registry。aqua preset は kiro.dev/... を拾わない）。Kiro は GitHub Releases が無く、配布元の manifest.json（最新版だけを返す）を customDatasources.kiro で読む",
      "customType": "regex",
      "managerFilePatterns": ["/^dot_config/aquaproj-aqua/aqua\\.yaml$/"],
      "matchStrings": ["- name: kiro\\.dev/kiro-cli@(?<currentValue>[^\\s#]+)"],
      "depNameTemplate": "kiro.dev/kiro-cli",
      "datasourceTemplate": "custom.kiro",
      "versioningTemplate": "semver"
    },
    {
      "description": "Intel Mac で配布元から直接入れるフォントの版。直前の行の `# renovate:` コメントで取得元を指定する",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.chezmoiscripts/run_onchange_before_10-install-packages\\.sh\\.tmpl$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "共有ストアへ置く agmsg（AGMSG_VERSION=\"<ver>\" とその tag の commit。直後の行の AGMSG_COMMIT も currentDigest として一緒に上げる）",
      "customType": "regex",
      "managerFilePatterns": ["/^bootstrap/22-shared-agmsg\\.sh$/"],
      "matchStrings": [
        "AGMSG_VERSION=\"(?<currentValue>[^\"]+)\"\\nAGMSG_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "fujibee/agmsg",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "autoReplaceStringTemplate": "AGMSG_VERSION=\"{{{newValue}}}\"\nAGMSG_COMMIT=\"{{{newDigest}}}\""
    },
    {
      "description": "共有ストアへ入れる npm の CLI（NPM_GLOBALS=\"$NPM_GLOBALS <pkg>@<ver>\"）",
      "customType": "regex",
      "managerFilePatterns": ["/^bootstrap/23-shared-npm\\.sh$/"],
      "matchStrings": [
        "NPM_GLOBALS=\"\\$NPM_GLOBALS (?<depName>(?:@[^/\\s\"]+/)?[^@\\s\"]+)@(?<currentValue>[^\\s\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "description": "共有ストアへ入れる uv の CLI（UV_TOOLS=\"$UV_TOOLS <pkg>[extra,...]==<ver>\"）。depName は extra を除いたパッケージ名",
      "customType": "regex",
      "managerFilePatterns": ["/^bootstrap/24-shared-uv\\.sh$/"],
      "matchStrings": [
        "UV_TOOLS=\"\\$UV_TOOLS (?<depName>[^\\[=\\s\"]+)(?:\\[[^\\]\\s\"]*\\])?==(?<currentValue>[^\\s\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "共有ストアへ入れる Rust の toolchain（RUST_VERSION=\"<ver>\"）",
      "customType": "regex",
      "managerFilePatterns": ["/^bootstrap/25-shared-rust\\.sh$/"],
      "matchStrings": ["RUST_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "minor / patch は種別（aqua / npm / フォント / GitHub Actions）を問わず 1 本の PR にまとめる。新しい PR を作るのは月曜 0〜8 時台だけ（既存 PR の rebase は毎回の実行で行う）",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "deps",
      "commitMessagePrefix": "chore(deps):",
      "commitMessageAction": "",
      "commitMessageTopic": "依存を更新する",
      "commitMessageExtra": "",
      "group": { "commitMessageTopic": "依存を更新する" },
      "prBodyNotes": [
        "マージ後、どのマシンでも誰か 1 人が `chezmoi update` すれば共有ストアが揃い、他のユーザは次の起動から新しい版を使う（docs/shared-store-cheatsheet.md）。"
      ]
    },
    {
      "description": "Codex（aqua.yaml の openai/codex@rust-v...）は aqua preset の専用 manager が `rust-` を外した v... で追う。同じ行を汎用 manager も rust-v... のまま拾い、タグ名が合わず誤った版を提案するので、そちらは止める",
      "matchDepNames": ["openai/codex"],
      "matchCurrentValue": "/^rust-/",
      "enabled": false
    },
    {
      "description": "Kiro CLI の manifest.json は公開日時を返さないので、リリースからの経過日数を待たない",
      "matchDepNames": ["kiro.dev/kiro-cli"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "1password/cli は GitHub リリースを持たず Renovate が版を解決できない(no-result)ため更新対象から除外する",
      "matchPackageNames": ["1password/cli"],
      "enabled": false
    },
    {
      "description": "simulot/immich-go は v 無しの迷子タグ 1.21.3(2024) が semver-coerced で最新扱いされ誤って major upgrade を提案する。実際の最新は v0.32.0、次期 major は v1.0.0-alpha1(プレリリース)なので 1.x を除外する",
      "matchPackageNames": ["simulot/immich-go"],
      "allowedVersions": "<1.0.0"
    }
  ]
}
