#!/usr/bin/env bash
# agmsg の codex エージェントを、Amazon Bedrock で動く状態で herdr のペインに立ち上げる。
#
# 素の `spawn.sh codex <name>` との違いは CODEX_HOME だけ。ただしそれを差し込む隙が
# spawn.sh には無い:
#   - spawn.sh の herdr パス(launch_in_herdr)は `herdr pane split` を --env 無しで呼ぶ
#   - マニフェスト(drivers/types/codex/type.conf)の `cli=codex` は固定で差し替えられない
#   - codex には --profile 相当の環境変数が無い(CODEX_HOME だけが env で効く)
# そこで env 付きのペインを先に作り、spawn.sh には --terminal テンプレートで「そのペインで
# boot script を走らせる」とだけ指示する。
#
# ~/.config/zsh/no-codex-bedrock を置くと、対話シェルの `codex` と同じく素の codex
# (OpenAI サブスク)で spawn する。マーカー 1 つで手打ちと spawn が一緒に切り替わる。
#
# 使い方: codex-bedrock-spawn <name> [options]
#   --team <team>        参加させるチーム(既定: プロジェクトの登録から解決)
#   --project <path>     起動先プロジェクト(既定: $PWD)
#   --direction right|down   ペインの分割方向(既定: right)
#   その他の引数はそのまま spawn.sh へ渡す(--boot-prompt / --model / --fresh など)
#
# 片付けは素の agmsg と同じ: despawn.sh <team> <self> <name> --force
# 詳細: ~/.local/share/chezmoi/docs/zsh-cheatsheet.md
set -euo pipefail

SKILL_DIR="$HOME/.agents/skills/agmsg"
S="$SKILL_DIR/scripts"

die() {
	printf 'codex-bedrock-spawn: %s\n' "$*" >&2
	exit 1
}

NAME=""
TEAM=""
PROJECT="$PWD"
DIRECTION="right"
PASS=()

while [ "$#" -gt 0 ]; do
	case "$1" in
	--team)
		TEAM="${2:-}"
		shift 2
		;;
	--project)
		PROJECT="${2:-}"
		shift 2
		;;
	--direction)
		DIRECTION="${2:-}"
		shift 2
		;;
	-h | --help)
		sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	# spawn.sh のフラグのうち値を取るものは、その値も一緒に運ぶ。「次が非フラグなら値」と
	# みなすと `--fresh <name>` の <name> まで吸ってしまうので、ここは明示列挙する。
	--boot-prompt | --split | --terminal | --ready-timeout | --model)
		PASS+=("$1")
		if [ "$#" -gt 1 ]; then
			PASS+=("$2")
			shift
		fi
		shift
		;;
	# 残りは値を取らないフラグと `--opt=value` 形式として素通しする。
	-*)
		PASS+=("$1")
		shift
		;;
	*)
		[ -n "$NAME" ] && die "名前は 1 つだけ指定する(余分: $1)"
		NAME="$1"
		shift
		;;
	esac
done

[ -n "$NAME" ] || die "エージェント名を指定する。例: codex-bedrock-spawn reviewer"
[ -d "$PROJECT" ] || die "プロジェクトが存在しない: $PROJECT"
PROJECT="$(cd "$PROJECT" && pwd -P)"

[ -n "${HERDR_PANE_ID:-}" ] || die "herdr のペインの中で実行する(HERDR_PANE_ID が無い)"
command -v herdr >/dev/null 2>&1 || die "herdr が PATH に無い"
[ -x "$S/spawn.sh" ] || die "agmsg が見つからない: $S/spawn.sh"

# 起動先の配信モードを monitor にする。配信フックは起動先ディレクトリの .codex/hooks.json
# にあり、git で持ち回れない(gitignore 済み)うえ worktree ごとに別なので、無いまま起動すると
# bridge が上がらず send.sh の依頼が届かない。set は冪等で、既に monitor なら何も変えない。
# 素の codex へ委譲するときも要るので、マーカー判定より前に置く。
MODE="$("$S/delivery.sh" status codex "$PROJECT" 2>/dev/null | sed -n 's/^mode: \([a-z]*\).*/\1/p' | head -1)"
if [ "$MODE" != "monitor" ]; then
	"$S/delivery.sh" set monitor codex "$PROJECT" >/dev/null ||
		die "配信モードを monitor にできなかった: $PROJECT"
	printf 'codex-bedrock-spawn: 配信モードを monitor にした(%s → monitor): %s\n' "${MODE:-off}" "$PROJECT" >&2
fi

# 素の codex へ戻すマーカー。対話シェルの `codex` 関数と同じファイルを見るので、置けば
# 手打ちと spawn の両方が OpenAI サブスクへ戻る。素の codex なら env を差し込む必要が無く、
# ペインの配置も spawn.sh の herdr パスに任せられるので、そのまま渡して終わる。
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/no-codex-bedrock" ]; then
	exec "$S/spawn.sh" codex "$NAME" --project "$PROJECT" \
		${TEAM:+--team "$TEAM"} ${PASS[@]+"${PASS[@]}"}
fi

# Bedrock 用プロファイル。起動前チェックとペインの env の両方で使う。既定はハードコード
# しない(codex-bedrock と同じ解決順)。
PROFILE="${CODEX_BEDROCK_AWS_PROFILE:-${AWS_PROFILE:-}}"
[ -n "$PROFILE" ] ||
	die "CODEX_BEDROCK_AWS_PROFILE を設定するか aws-switch でプロファイルを選択する"

# チームは spawn.sh も自動解決するが、placement レコードを自前で書くのでこちらでも要る。
# 採用するのは whoami が「このプロジェクト自身の登録」を返したとき(agent= / multiple=)だけ。
# suggest= は他プロジェクトの登録からの提案、not_joined= は未参加で、どちらも teams= を
# 含みうるが、それを使うと別リポジトリのチームへ codex を join させてしまう。
if [ -z "$TEAM" ]; then
	WHO="$("$S/whoami.sh" "$PROJECT" 2>/dev/null || true)"
	case "$WHO" in
	agent=* | multiple=*) ;;
	*) die "このプロジェクトはまだチームに参加していない($PROJECT)。プロジェクトの cwd で /agmsg から join するか、--team で指定する" ;;
	esac
	TEAM="$(printf '%s\n' "$WHO" | tr ' ' '\n' | sed -n 's/^teams=//p' | head -1)"
	case "$TEAM" in
	"") die "チームを解決できない。--team で指定する" ;;
	*,*) die "このプロジェクトは複数チームに属している($TEAM)。--team で指定する" ;;
	esac
fi

# herdr の JSON から 1 つの文字列フィールドを取り出す。端末制御シーケンスが混ざるので落とす。
herdr_field() {
	python3 -c '
import json, re, sys
text = re.sub(r"\x1b\[[0-9;<=?]*[a-zA-Z]", "", sys.stdin.read()).strip()
text = text[text.index("{"):text.rindex("}") + 1]
value = json.loads(text)
for key in sys.argv[1:]:
    value = value[key]
print(value)
' "$@"
}

# 1) Bedrock 用プロファイルの認証を済ませる。spawn 先の codex は codex-bedrock を通らない
#    (spawn.sh が cli=codex を直接 exec する)ので、未認証のままだと立ち上がった TUI の中へ
#    credential_process(aws-login)がログイン URL を描いて画面が崩れる。ここは人が居る対話ペイン
#    なので、未認証ならその場でログインまで進む。
if [ -x "$HOME/.local/bin/aws-auth-ensure" ]; then
	"$HOME/.local/bin/aws-auth-ensure" "$PROFILE" "Bedrock" ||
		die "Bedrock 用プロファイル $PROFILE が未認証のため spawn しない"
fi

# 2) Bedrock 用の一時 home を用意する(既にあれば作り直さない)。
HOME_DIR="$(cd "$PROJECT" && codex-bedrock --print-home)" ||
	die "一時 home を用意できなかった"

# 3) このプロジェクトを信頼させる。codex は信頼するまでプロジェクトローカルの config /
#    hooks / exec policy を読まないので、agmsg が置く .codex/hooks.json(配信フック)が効かない。
#    書くのは揮発する一時 home の config.toml だけで、素の ~/.codex/config.toml には触らない
#    ——信頼するのは agmsg が立ち上げたこの codex に限る。
case "$PROJECT" in
*'"'* | *\\*) die "パスに \" か \\ を含むプロジェクトは信頼設定を書けない: $PROJECT" ;;
esac
if ! grep -qF "[projects.\"$PROJECT\"]" "$HOME_DIR/config.toml"; then
	cat >>"$HOME_DIR/config.toml" <<EOF

[projects."$PROJECT"]
trust_level = "trusted"
EOF
fi

# 4) 別の CODEX_HOME で走っている app-server は畳む。残っているとペインの codex が
#    それを再利用してしまい、設定が食い違う。
(cd "$PROJECT" && codex-appserver-evict "$HOME_DIR")

# 5) env 付きでペインを作る。ここが素の spawn.sh との唯一の実質的な差。
# AWS_LOGIN_NO_INTERACTIVE は、走行中に期限が切れたときログイン URL をこのペインへ
# 描かせないため。代わりに aws-login が herdr のタブへ委譲する(docs/aws-cheatsheet.md)。
resp="$(herdr pane split "$HERDR_PANE_ID" --direction "$DIRECTION" --no-focus --cwd "$PROJECT" \
	--env "CODEX_HOME=$HOME_DIR" \
	--env "AWS_PROFILE=$PROFILE" \
	--env "AWS_LOGIN_NO_INTERACTIVE=1" 2>&1)" ||
	die "herdr pane split に失敗した: $resp"
PANE="$(printf '%s' "$resp" | herdr_field result pane pane_id)" ||
	die "herdr pane split の応答から pane_id を読めなかった: $resp"

# ここから先の失敗は、起動済みのペインと書きかけの placement レコードを残す。最後まで
# 通ったときだけ trap を解いて残す。
rollback() {
	herdr pane close "$PANE" >/dev/null 2>&1 || true
	[ -n "${rec:-}" ] && rm -f "$rec"
	return 0
}
trap rollback EXIT

herdr pane rename "$PANE" "$NAME" >/dev/null 2>&1 || true

# 6) spawn 本体。HERDR_ENV / HERDR_PANE_ID を落とすのは、配置の優先度が
#    $TMUX → herdr → --terminal テンプレートで、落とさないと herdr パスが先に勝って
#    env 無しのペインを作り直してしまうため。
#    TMPDIR をユーザ専用の場所に向けるのは、spawn.sh が boot script を
#    ${TMPDIR:-/tmp}/agmsg-spawn という固定名のディレクトリに置くため。共有ホストでは最初に
#    spawn した人の所有になり、他のユーザは mktemp で permission denied になる。ここで渡す
#    TMPDIR は spawn.sh と boot script の配置にだけ効き、ペインの codex には届かない
#    (ペインは 5 で作成済み)。
SPAWN_TMPDIR="${XDG_RUNTIME_DIR:-$HOME/.cache/agmsg}"
mkdir -p "$SPAWN_TMPDIR"
env -u HERDR_ENV -u HERDR_PANE_ID -u TMUX TMPDIR="$SPAWN_TMPDIR" \
	"$S/spawn.sh" codex "$NAME" --project "$PROJECT" --team "$TEAM" \
	--terminal "herdr pane run $PANE {cmd}" ${PASS[@]+"${PASS[@]}"} ||
	die "spawn.sh に失敗した"

# 7) placement レコード。テンプレート経路は書かないので、herdr パスと同じ形式で補う。
#    これが無いと despawn --force が no placement record で失敗する。既存レコードは常に
#    上書きする。前の異常終了で古い pane_id が残っていると、despawn --force がそちらを
#    畳んで今のペインを取り逃がす。
# shellcheck disable=SC1091
. "$S/lib/actas-lock.sh"
rec="$(agmsg_spawn_path "$TEAM" "$NAME")"
mkdir -p "$(dirname "$rec")"
printf 'herdr:%s\t%s\t%s\n' "$PANE" "$PROJECT" "codex" >"$rec"

trap - EXIT

cat <<EOS
spawned codex '$NAME' (team $TEAM) in herdr pane $PANE
  CODEX_HOME  $HOME_DIR
  AWS_PROFILE $PROFILE
  片付け      $S/despawn.sh $TEAM <self> $NAME --force
EOS
