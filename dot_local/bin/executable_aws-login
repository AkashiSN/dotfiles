#!/bin/bash
# aws-login - aws login ラッパースクリプト（認証本体）
#
# ~/.aws/config の credential_process に登録され、AWS CLI/SDK が認証情報を
# 必要としたときに自動で呼ばれる。aws-switch からも認証の前段として呼ばれる。
# 各プロファイルごとに独立したセッションを管理する。
#
# 使用方法:
#   aws-login <profile_name>
#   - profile_name: ベースプロファイル名（自動的に"-signin"サフィックスが付与されます）
#
# 動作:
#   0. 直近の出力を残したファイルキャッシュを見て、期限に余裕があれば aws CLI を起動せず返す
#      （credential_process は 1 署名につき複数回呼ばれうるため。理由は下の CREDS_CACHE を参照）
#   1. キャッシュから認証情報を取り出し、aws sts get-caller-identity で「実際に通るか」を検証
#      （クレデンシャルが設定されているか、ではなく、いま有効か で判定する）
#   2. 期限切れ／未ログインならブラウザでログインを実行
#   3. STS が到達不能（ネットワーク断等）の一時エラーなら、ログインせずキャッシュで続行
#   4. flockで排他制御し、複数プロセスの同時ログインを防止。待たされるときは理由と相手を
#      表示し、呼び出し元を失って居座っているログインは落として先へ進む
#      （落とすまでに ORPHAN_GRACE の猶予を置く。下の「居座ったログインの掃除」を参照）
#   - get-caller-identity は IAM 権限不要なので、失敗＝トークンが無効/期限切れ を意味する。
#     AWS_LOGIN_SKIP_VERIFY=1 で STS 検証を省略し、「設定があれば OK」で通すこともできる。
#   5. どう判断したかを `~/.aws/.aws-login.log` へ 1 行ずつ残す（認証情報は書かない）。
#      認証情報の更新は 15 分ごとに走り、そこを複数プロセスが同時に踏むため、pid と時刻が
#      無いと「本当に期限切れだったのか、更新の競合や一時エラーだったのか」を切り分けられない。
#   - AWS_LOGIN_NO_INTERACTIVE=1 が立っているときは、未認証でもログインへ進まずエラーで
#     終わる（/dev/tty へは何も書かない）。TUI アプリ（Claude Code）は子プロセスへこれを
#     継承させ、画面の中にログイン URL が割り込んで描かれるのを防ぐ。起動前の認証は
#     aws-auth-ensure が済ませておく。
#     この場合でも認証切れの事実は次の 2 つで人へ伝わる（下の「委譲」節）。
#       - herdr セッション内なら、認証用のタブを開いてそちらでログインしてもらう
#       - `~/.aws/.aws-login-<profile>.expired` を置き、Claude Code の statusLine が拾う
#
# SSH 先での挙動:
#   通常の `aws login` は localhost のコールバックサーバ前提で、SSH 先だとブラウザも
#   開かず localhost に戻ってしまい完結しない。そこで SSH セッションでは
#   `aws login --remote` を使う。--remote は localhost コールバックを無効化し、
#   URL 表示＋認証コード貼り付け方式に切り替える（公式のリモート用フロー）。
#
#   ただし「ローカルのブラウザを開けて localhost コールバックも戻ってくる」経路が
#   あるときは --remote を付けず、通常のコールバック方式をそのまま使う。該当するのは 2 つ。
#
#   (a) portfwd 逆チャネル（docs/portfwd-cheatsheet.md）。オプトインしたホストへの SSH では
#       LC_PORTFWD_HOST が渡り、.zshenv が $BROWSER を portfwd-open に向ける。
#       逆チャネルの Unix domain socket 越しに daemon が /health に応答すれば、URL は
#       ローカル mac のブラウザで開き、コールバックは SOCKS5 リレー経由で SSH 先の
#       loopback へ戻る。
#       到達できないとき（daemon 停止・逆チャネル未設定）は --remote へフォールバックする。
#       $BROWSER の有無ではなく実際の到達性で判定するのはこのため。
#       フォールバックした理由は /dev/tty へ出す。aws-switch は aws-login の出力を捨てるため、
#       stderr へ出すと「なぜブラウザが開かなかったのか」がどこにも残らない。
#   (b) VSCode Remote などのリモート開発環境。$BROWSER に「ローカルのブラウザを開く
#       ヘルパー」を仕込み、さらに localhost のポートを自動フォワードするため、SSH 先でも
#       通常のコールバック方式がそのまま成立する（ブラウザが自動で開き、コード貼り付けも
#       不要）。判定は $BROWSER が空でないかどうかだけ。ただし $BROWSER が portfwd-open の
#       ときは (a) の到達性判定が済んでいるので、ここには落ちてこない扱いにする。
#
#   どの分岐でも URL/プロンプトは呼び出し元の出力抑制を貫通させるため制御端末（/dev/tty）に
#   直結する。
#
# 注意:
#   - プロファイルごとに異なるキャッシュを持つため、
#     ユーザー権限とAssume Role権限を別々に管理できる
#
# 依存:
#   - flock: 多重ログイン防止に使用。aqua には無い。
#            Linux は util-linux 同梱、macOS は Homebrew（brew install flock）で導入する。

set -e

# プロファイル名は必須。空のまま進むと "-signin" という別プロファイルを掴んでしまい、
# 呼び出し元の不具合が「意図しないプロファイルでのログイン」として表面化する。
if [[ -z $1 ]]; then
	echo "aws-login: プロファイル名を指定してください（例: aws-login my-profile）" >&2
	exit 1
fi

# プロファイル名に"-signin"サフィックスを付与
# 例: "my-profile" → "my-profile-signin"
export AWS_PROFILE="$1-signin"

# リージョンは -signin プロファイルのものだけを使う。signin のエンドポイントはリージョナル
# （https://<region>.signin.aws.amazon.com）で、refresh token はログインしたリージョンでしか
# 通らない。呼び出し元の環境変数はプロファイルの region より優先されるため、Bedrock 用に
# AWS_REGION=us-east-1 を持つ Claude Code の配下から credential_process として呼ばれると、
# 更新が毎回 INVALID_REQUEST で弾かれる。ここで捨てて、どこから呼ばれても同じ場所へ行かせる。
unset AWS_REGION AWS_DEFAULT_REGION

# EC2インスタンスのメタデータサービスを無効化
# ローカル環境でEC2の認証情報が誤って使用されるのを防ぐ
export AWS_EC2_METADATA_DISABLED=true

# 認証情報のファイルキャッシュ。
#
# credential_process は「必要になったとき 1 回」呼ばれるとは限らない。発行される認証情報の
# 寿命が botocore の advisory refresh window(900 秒)を下回っていると、SDK は署名のたびに
# 「そろそろ更新すべき」と判断し、しかも access_key / secret_key / token の各プロパティ参照で
# 個別に更新を試みるため、1 回の署名で数回ここが呼ばれる。このスクリプトは通常経路で
# aws CLI を 2 回起動する(export-credentials 0.7 秒 + sts get-caller-identity 0.9 秒)ので、
# 1 回 2.4 秒が十数秒に増幅される。MCP サーバーのように起動時に何度も署名する利用者は
# これで数十秒待たされ、接続タイムアウト(30 秒)に掛かる。
#
# そこで直近の出力をファイルに残し、Expiration に余裕がある間は aws CLI を起動せず
# それを返す(0.02 秒)。期限が近づけば通常経路へ落ち、aws CLI が新しいセッションを
# 発行してキャッシュも更新されるので、自動更新の仕組みは変わらない。
#
# キャッシュを返す間は STS 検証を挟まない。認証情報の寿命そのものが短いので窓は限られ、
# 途中で無効化された場合も API 呼び出しが認証エラーになるだけで復旧できる。ただし
# aws-logout はトークンを破棄してもこのファイルの期限は縮まらないので、あちらで消している。
CREDS_CACHE="$HOME/.aws/.aws-login-${1}.creds.json"
# 期限までこれだけ残っていればキャッシュを使う。
CREDS_CACHE_MIN_REMAINING=120

# 「対話ログインできない場所で認証切れを踏んだ」ことを残す marker。
# Claude Code の statusLine がこれを見て警告を出す（~/.claude/hooks/statusline.sh）。
# statusLine は毎描画で走るので、そちらに STS を叩かせず、認証を実際に要求した側が置く。
EXPIRED_MARKER="$HOME/.aws/.aws-login-${1}.expired"

# ログインの排他ロック。同じプロファイルで同時にブラウザを開かないため。
LOGIN_LOCK="$HOME/.aws/.aws-login-${1}.lock"
# ロックが空くのを待つ上限。
LOGIN_LOCK_WAIT=60

# 認証情報の更新の排他ロック。ログインロックとは別に持つ。creds キャッシュはプロファイル単位の
# 共有ファイルなので、期限が近づくとそのプロファイルを使う全プロセスが一斉に更新へ進む。更新は
# refresh token を 1 回使い切りで差し替えるため、同時に踏むと片方が弾かれ、セッションが生きて
# いても「認証切れ」として見える。
REFRESH_LOCK="$HOME/.aws/.aws-login-${1}.refresh.lock"
# 更新のロックが空くのを待つ上限[秒]。更新は export-credentials と STS の 2 回で 2 秒ほど。
REFRESH_LOCK_WAIT=20

# 更新が失敗したときに試し直す回数と、その前に待つ秒数。
# 同じ refresh token が一瞬だけ弾かれ、数秒後には通ることがある（CreateOAuth2Token が
# "authorization grant is invalid" を返す）。実測ではこの状態が 3〜4 秒続いたので、その窓を
# 越えられるだけ試す。credential_process は SDK に待たされている経路なので、これ以上は伸ばさない。
REFRESH_RETRY=2
REFRESH_RETRY_WAIT=2

# 「更新できなかったが、ログインセッションはまだ生きている」状態が続いたとき、これを超えたら
# 人に見せる[秒]。セッションが生きているなら人がブラウザで入り直す必要は無いので、ふつうは
# 委譲を見送る。ただしいつまでも creds が取れないなら別の異常なので、黙り続けない。
TRANSIENT_MARKER="$HOME/.aws/.aws-login-${1}.transient"
TRANSIENT_GRACE=180
# 待っている間に保持者を見直す間隔[秒]。待ち始めた時点では猶予の内側だった孤児が、
# 待っているうちに猶予を超えることがあるので、上限まで一息に寝ない。
LOCK_POLL_INTERVAL=2
# 呼び出し元を失ったログインを落とすまでの猶予[秒]。呼び出し元が消えた直後はまだ人が
# ブラウザで認証を続けていることがあり、localhost コールバックさえ戻れば aws login は
# 自力で完了できる。そこを横から落とすと操作が無駄になる。
ORPHAN_GRACE=180
# 自分の側のプロセスを見分けるための起点。サブシェルの $$ は親の値を引き継ぐので、
# ここで一度だけ確定させる。
SELF_PID=$$

# 判断の記録。認証情報の更新は 15 分ごとに走り、そこを同時に踏むプロセスが複数あるため、
# 「誰がいつ何と判断したか」が無いと切り分けられない。プロファイルごとではなく 1 本にまとめる
# のは、別プロファイルの更新と並んで初めて同時刻の重なりが見えるため。
#
# 認証情報そのものは書かない。creds は emit_creds だけが扱い、ここへは渡さない。
AWS_LOGIN_LOG="$HOME/.aws/.aws-login.log"
# これを超えたら古い側を捨てる。参照するのは事象が起きた直後だけなので、直近が残れば足りる。
AWS_LOGIN_LOG_MAX_BYTES=524288
# 記録に添えるプロファイル名。関数の中では $1 が引数になるので、ここで押さえておく。
LOG_PROFILE="$1"
# 認証情報の更新に失敗したときの理由の受け皿。stdout は creds 専用なので、stderr は
# 混ぜずに別で受ける。終了時に必ず片付ける。
REFRESH_ERR_FILE="$HOME/.aws/.aws-login-${1}.stderr.$$"
trap 'rm -f "$REFRESH_ERR_FILE" 2>/dev/null || true' EXIT

# コマンドの stderr を 1 行へ潰して長さを切る。
log_detail() {
	printf '%s' "$1" | tr '\n\t' '  ' | cut -c1-200
}

# <イベント> [詳細] を 1 行で残す。書けなくても認証は続ける。
log_event() {
	local size tmp
	if [ -f "$AWS_LOGIN_LOG" ]; then
		size=$(wc -c <"$AWS_LOGIN_LOG" 2>/dev/null) || size=0
		if [ "${size:-0}" -gt "$AWS_LOGIN_LOG_MAX_BYTES" ]; then
			tmp="${AWS_LOGIN_LOG}.tmp.$$"
			if tail -c $((AWS_LOGIN_LOG_MAX_BYTES / 2)) "$AWS_LOGIN_LOG" >"$tmp" 2>/dev/null; then
				mv -f "$tmp" "$AWS_LOGIN_LOG" 2>/dev/null || rm -f "$tmp" 2>/dev/null
			else
				rm -f "$tmp" 2>/dev/null
			fi
		fi
	else
		# 他ユーザに読ませない権限で作ってから追記する。
		(
			umask 077
			: >"$AWS_LOGIN_LOG"
		) 2>/dev/null || true
	fi
	printf '%s pid=%s ppid=%s profile=%s event=%s%s\n' \
		"$(date +%Y-%m-%dT%H:%M:%S%z)" "$SELF_PID" "$PPID" "$LOG_PROFILE" "$1" \
		"${2:+ detail=\"$2\"}" >>"$AWS_LOGIN_LOG" 2>/dev/null || true
}

mark_expired() {
	: >"$EXPIRED_MARKER" 2>/dev/null || true
}

clear_expired() {
	rm -f "$EXPIRED_MARKER" "$TRANSIENT_MARKER" 2>/dev/null || true
}

# -signin のログインセッションがまだ通るか。呼び出し元が持ち込んだ認証情報や EC2 インスタンス
# ロールを拾わないよう断ってから叩く（AWS_PROFILE は既に -signin に固定済み）。
signin_session_alive() {
	env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
		AWS_EC2_METADATA_DISABLED=true \
		aws sts get-caller-identity >/dev/null 2>&1
}

# 人がブラウザで入り直す必要があるか。あれば 0、無ければ 1。
#
# 更新に失敗しても、ログインセッションが生きているなら人にできることは無い（更新が一時的に
# 弾かれただけで、次の呼び出しで直る）。そこで委譲を見送る。ここで popup を開くと、人が何も
# しないうちに消える無駄な割り込みになる。
#
# ただし「セッションは生きているのに creds が取れない」が続くなら別の異常なので、猶予を超えたら
# 人に見せる。
human_login_needed() {
	local first now
	if ! signin_session_alive; then
		rm -f "$TRANSIENT_MARKER" 2>/dev/null || true
		return 0
	fi
	now=$(date +%s)
	first=$(cat "$TRANSIENT_MARKER" 2>/dev/null) || first=""
	case "$first" in
	'' | *[!0-9]*)
		printf '%s\n' "$now" >"$TRANSIENT_MARKER" 2>/dev/null || true
		return 1
		;;
	esac
	if [ $((now - first)) -gt "$TRANSIENT_GRACE" ]; then
		log_event transient-grace-exceeded "since=$((now - first))s"
		rm -f "$TRANSIENT_MARKER" 2>/dev/null || true
		return 0
	fi
	return 1
}

# ISO8601 の時刻を epoch 秒へ。読めなければ何も出力せず非 0。
# GNU date(Linux) は -d でそのまま読めるが、BSD date(macOS) は -j -f で書式を渡すうえ
# %z が +0000 形式しか受け取らないため、末尾のオフセットを均してから渡す。
to_epoch() {
	local ts="$1"
	date -d "$ts" +%s 2>/dev/null && return 0
	ts="${ts%Z}"
	case "$ts" in
	*[+-][0-9][0-9]:[0-9][0-9]) ts="${ts%:*}${ts##*:}" ;; # +00:00 -> +0000
	*[+-][0-9][0-9][0-9][0-9]) ;;                         # すでに +0000
	*) ts="${ts}+0000" ;;                                 # Z / オフセット無しは UTC
	esac
	date -j -f '%Y-%m-%dT%H:%M:%S%z' "$ts" +%s 2>/dev/null
}

# キャッシュが使えるならその内容を出力して 0 を返す。使えなければ 1。
emit_cached_creds() {
	local exp exp_epoch remaining
	[ -r "$CREDS_CACHE" ] || return 1
	exp=$(sed -n 's/.*"Expiration"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CREDS_CACHE")
	[ -n "$exp" ] || return 1
	exp_epoch=$(to_epoch "$exp") || return 1
	[ -n "$exp_epoch" ] || return 1
	remaining=$((exp_epoch - $(date +%s)))
	[ "$remaining" -gt "$CREDS_CACHE_MIN_REMAINING" ] || return 1
	log_event cache-hit "remaining=${remaining}s"
	cat "$CREDS_CACHE"
}

# creds を出力しつつキャッシュを更新する。
# 認証情報を平文で置くので、作成した瞬間から他ユーザに読めないよう umask で絞る。
# 書き込みに失敗しても認証自体は成立しているので、出力を優先して握りつぶす。
emit_creds() {
	local tmp
	printf '%s\n' "$1"
	tmp="${CREDS_CACHE}.tmp.$$"
	if (
		umask 077
		printf '%s\n' "$1" >"$tmp"
	) 2>/dev/null; then
		mv -f "$tmp" "$CREDS_CACHE" 2>/dev/null || rm -f "$tmp"
	fi
}

# ここから下は aws CLI を起動する。キャッシュが使えるなら触らずに終える。
if emit_cached_creds; then
	clear_expired
	exit 0
fi

# "-signin"プロファイルが存在していない場合
if ! aws configure list-profiles | grep "$AWS_PROFILE" >/dev/null 2>&1; then
	# AWSリージョンを東京に設定
	aws configure set region ap-northeast-1
fi

# キャッシュ済み認証情報が「実際に有効か」を STS で検証するヘルパー。
#   - export-credentials で creds を取り出す。ログインセッションのアクセストークンは寿命が
#     短く、切れていればここで refresh token を使った更新が走る（ネットワークを使う）。
#     更新は 1 回ごとに refresh token を差し替えるので、同じプロファイルを使う複数プロセスが
#     同時に踏むと片方が失敗しうる。失敗の理由は log_event で残す。
#   - 取り出せたら aws sts get-caller-identity で実際に通るかを確認する。
#     credential_process の stdout は creds 出力専用なので STS の出力は捨て、stderr だけを
#     拾ってエラー種別を判定する。AWS_PROFILE は -signin に固定済みで、signin プロファイルは
#     credential_process を持たない（base プロファイルのみが持つ）ため、この STS 呼び出しは
#     aws-login へ戻らず再帰しない。get-caller-identity は IAM 権限不要なので、失敗＝
#     トークンが無効/期限切れ を意味する。
# 戻り値:
#   0 : 有効。creds を stdout に出力済み
#   2 : STS が到達不能（ネットワーク断等）で検証できず。期限内の可能性が高いのでキャッシュ
#       creds を出力済み（ログインはしない）
#   1 : 未ログイン or 認証切れ。creds 未出力（呼び出し側はログインへ進む）
emit_creds_if_valid() {
	local creds refresh_err sts_err attempt=0
	# export-credentials の stderr は捨てずに拾う。ここは「ローカルキャッシュを読むだけ」では
	# なく、アクセストークンが切れていればネットワーク越しの更新を含む。失敗の理由を残さないと、
	# 更新の競合・一時エラー・セッション満了のどれなのかが後から分からなくなる。
	#
	# 失敗しても即座に認証切れとは決めず、いちど待って試し直す。1 回目の失敗も記録に残す。
	while :; do
		if creds=$(aws configure export-credentials --format process 2>"$REFRESH_ERR_FILE"); then
			[ -n "$creds" ] || {
				log_event refresh-empty
				return 1
			}
			if [ "$attempt" -gt 0 ]; then
				log_event refresh-retry-ok "attempt=$((attempt + 1))"
			else
				log_event refresh-ok
			fi
			break
		fi
		refresh_err=$(cat "$REFRESH_ERR_FILE" 2>/dev/null) || refresh_err=""
		log_event refresh-fail "$(log_detail "$refresh_err")"
		# セッションが終わっているとはっきり言われているなら、待っても通らない。
		case "$refresh_err" in
		*"session has expired"* | *"Token has expired"* | *"reauthenticate"*) return 1 ;;
		esac
		[ "$attempt" -lt "$REFRESH_RETRY" ] || return 1
		attempt=$((attempt + 1))
		sleep "$REFRESH_RETRY_WAIT"
	done
	# 抜け道: STS 検証を省略し、「設定があれば OK」で通す。
	if [ -n "$AWS_LOGIN_SKIP_VERIFY" ]; then
		emit_creds "$creds"
		return 0
	fi
	if sts_err=$(aws sts get-caller-identity 2>&1 >/dev/null); then
		emit_creds "$creds"
		return 0
	fi
	# STS 失敗。到達不能などの一時エラーならログインせずキャッシュで続行する。
	if printf '%s' "$sts_err" | grep -qiE 'could not connect|connect timeout|endpointconnectionerror|failed to establish|name resolution|getaddrinfo|name or service not known|network is unreachable|read timeout|connection (reset|aborted|refused)|temporarily unavailable|service unavailable|timed out'; then
		printf >&2 '%s\n' "aws-login: STS 検証をスキップ（${AWS_PROFILE}: ネットワーク到達不可）。キャッシュ済み認証情報で続行します。"
		log_event sts-unreachable "$(log_detail "$sts_err")"
		# 検証できていないのでキャッシュには残さない。次回も同じ判断をやり直す。
		printf '%s\n' "$creds"
		return 2
	fi
	# ExpiredToken / InvalidClientTokenId / SSO トークン期限切れ 等 → 認証切れとみなす。
	log_event sts-expired "$(log_detail "$sts_err")"
	return 1
}

# 更新を直列化して emit_creds_if_valid を呼ぶ。戻り値はそのまま通す。
#
# 要点は「ロックを取った後にキャッシュを見直す」こと。待っている間に他のプロセスが更新を
# 終えていればその結果を返し、自分は更新しない。rotate 済みの refresh token を掴んで弾かれる
# のを防ぐ。
#
# ロックが空かないときは諦めてロック無しで更新する。ここで止めると、ロックの取り合いが
# そのまま認証切れになってしまう。
refresh_serialized() {
	(
		local rc=0
		if ! flock -n 8; then
			if flock -w "$REFRESH_LOCK_WAIT" 8; then
				log_event refresh-wait
			else
				log_event refresh-lock-timeout
				emit_creds_if_valid || rc=$?
				exit "$rc"
			fi
		fi
		if emit_cached_creds; then
			log_event refresh-shared
			exit 0
		fi
		emit_creds_if_valid || rc=$?
		exit "$rc"
	) 8>"$REFRESH_LOCK"
}

# portfwd 逆チャネルが使えるか判定する（docs/portfwd-cheatsheet.md）。
#   - LC_PORTFWD_HOST がセット済み（オプトインしたホストへの SSH セッション）かつ
#     逆チャネルの Unix domain socket 越しに daemon が応答すれば、ローカルのブラウザを
#     開ける。この場合 aws login --remote ではなく通常の aws login（localhost
#     コールバック）を使う。
#   - 変数だけで判定しないのは、ssh config が SetEnv していても daemon が落ちていたり
#     RemoteForward の bind に失敗していたりするため。到達性まで見て初めて安全に
#     コールバック方式へ倒せる。
#   - connect ではなく GET /health まで確認する。逆チャネルのソケットは **SSH 先の
#     sshd が** 持つため、ローカルの daemon が死んでいても connect は成功してしまう
#     （実際には応答が無く、portfwd-open が空応答で落ちる）。daemon が返す
#     {"service":"portfwd",...} を見て初めて逆チャネルの生存を確認できる。
#     /health は pid 等を含めず、リモートから読まれる前提で設計されている。
#   - タイムアウトは portfwd-open の POST と同じ 5 秒。ローカルの daemon は常駐サービスの
#     起動直後などに応答へ 5 秒近くかけることがあり、短いと生きている逆チャネルを
#     取り逃して --remote へ落ちる。
PORTFWD_HEALTH_TIMEOUT=5

# 人へ伝えたいことを制御端末へ直結する。aws-switch は aws-login の出力を >/dev/null 2>&1 で
# 捨てるため、stderr へ出すとどこにも残らない（端末が無ければ捨てる。credential_process として
# 呼ばれた場合がこれにあたる）。
tty_notice() {
	if { : >/dev/tty; } 2>/dev/null; then
		printf 'aws-login: %s\n' "$1" >/dev/tty
	fi
}

# 人へ必ず届けたいエラー。端末があればそちらへ、無ければ stderr へ出す
# （両方に出すと端末で二重に見える）。
notify_error() {
	if { : >/dev/tty; } 2>/dev/null; then
		tty_notice "$1"
	else
		printf 'aws-login: %s\n' "$1" >&2
	fi
}

# ロックファイルを開いているプロセスの pid を列挙する（生の一覧。除外はしない）。
#
# 「ロックを作った pid」ではなく「ロックファイルを開いているプロセス」を探す。flock(1) 経由だと
# 補助プロセスは既に終了していて、実際に押さえているのは fd を継いだ側だからである
# （Linux の /proc/locks が載せるのは前者なので、そちらは見ない）。
# 探し方は 2 つ持つ。lsof があれば mac / Linux どちらでも 1 回起動で済む。無い Linux では
# /proc の fd シンボリックリンクを辿る（GNU find の -lname / -printf）。
lock_holder_pids_raw() {
	if command -v lsof >/dev/null 2>&1; then
		lsof -t -- "$LOGIN_LOCK" 2>/dev/null
		return 0
	fi
	[ -d /proc ] || return 0
	find /proc -mindepth 3 -maxdepth 3 -path '/proc/[0-9]*/fd/*' \
		-lname "$LOGIN_LOCK" -printf '%h\n' 2>/dev/null |
		sed 's#^/proc/##; s#/fd$##'
}

# pid の属性を 1 つ読む（ppid / pgid / etime）。ps 越しに読むので mac / Linux どちらでも同じ。
# fd 200 は継がせない。継ぐと自分自身がロックの保持者として見つかり、しかも評価する頃には
# 終わっているので、消えた pid を保持者として報告してしまう。
proc_field() {
	{ ps -o "$2=" -p "$1" 2>/dev/null | tr -d ' '; } 200>&-
}

# pid が ancestor 自身か、その子孫か。
is_descendant() {
	local pid="$1" ancestor="$2" depth=0
	while [ "$depth" -lt 64 ]; do
		[ "$pid" = "$ancestor" ] && return 0
		case "$pid" in
		'' | 0 | 1) return 1 ;;
		esac
		pid=$(proc_field "$pid" ppid)
		depth=$((depth + 1))
	done
	return 1
}

# そのうち自分の側を除いた pid。
# 自分の側は 2 段で外す。探索の間は fd 200 を閉じて子へ継がせず、それでも残る自分の
# サブシェル類は SELF_PID の子孫かどうかで落とす。プロセスグループで落とすと、同じジョブから
# 起きた別の aws-login まで一緒に外れて、保持者を見失う。
lock_open_pids() {
	local pid found=""
	for pid in $({ lock_holder_pids_raw; } 200>&-); do
		# 見つけてから評価するまでに終わったプロセスは、もう握っていない。
		kill -0 "$pid" 2>/dev/null || continue
		is_descendant "$pid" "$SELF_PID" && continue
		found="${found:+$found }$pid"
	done
	printf '%s' "$found"
}

# 保持者が属するジョブ（プロセスグループ）を遡り、呼び出し元が失われていればその起点の pid を
# 返す。起点の親が init になっている＝ログインを始めさせた側がもう居ないということで、
# 認証コードを貼る人も結果の戻り先も無く、ロックはこの先も空かない。
#
# 制御端末の有無では見分けられない。端末はセッション単位なので、同じ端末で別のアプリが
# 動いていれば tty は残ったままになる。
orphan_root() {
	local pid="$1" depth=0 jobpg ppid ppg
	jobpg=$(proc_field "$pid" pgid)
	[ -n "$jobpg" ] || return 1
	while [ "$depth" -lt 64 ]; do
		ppid=$(proc_field "$pid" ppid)
		[ -n "$ppid" ] || return 1
		if [ "$ppid" = "1" ]; then
			printf '%s' "$pid"
			return 0
		fi
		ppg=$(proc_field "$ppid" pgid)
		[ -n "$ppg" ] || return 1
		# 親が別のジョブにいるなら、そこが生きた呼び出し元。
		[ "$ppg" != "$jobpg" ] && return 1
		pid="$ppid"
		depth=$((depth + 1))
	done
	return 1
}

# プロセスの起動からの経過秒。ps の etime（[[dd-]hh:]mm:ss）を秒へ均す。
proc_age_seconds() {
	local e
	e=$(proc_field "$1" etime)
	[ -n "$e" ] || return 1
	printf '%s' "$e" | awk -F'[-:]' '{
        if (NF == 4) { print ((($1 * 24 + $2) * 60) + $3) * 60 + $4 }
        else if (NF == 3) { print (($1 * 60) + $2) * 60 + $3 }
        else if (NF == 2) { print $1 * 60 + $2 }
        else { print 0 }
    }'
}

# 引数の pid のうち 1 つでも生きていれば 0。
any_alive() {
	local pid
	for pid in "$@"; do
		kill -0 "$pid" 2>/dev/null && return 0
	done
	return 1
}

# ロック保持者の様子を 1 行で説明する。待っても無駄なのかどうかを先に伝える。
describe_lock_holder() {
	local pids pid root age
	pids=$(lock_open_pids)
	if [ -z "$pids" ]; then
		printf '特定できないプロセス'
		return
	fi
	for pid in $pids; do
		root=$(orphan_root "$pid") || continue
		age=$(proc_age_seconds "$root") || age=0
		printf 'pid %s（呼び出し元を失った aws login。起動から %s 秒で、この先も空きません）' \
			"$pids" "$age"
		return
	done
	printf 'pid %s' "$pids"
}

# 居座ったログインの掃除。呼び出し元を失ったままロックを握っている aws login を落とす。
# 落としたら 0、落とす相手が居なければ 1。
#
# ORPHAN_GRACE の猶予を置くのは、呼び出し元が消えた直後はまだ人がブラウザで認証を続けて
# いることがあるため。localhost コールバックさえ戻れば aws login は自力で完了してトークン
# キャッシュへ保存できるので、そこを横から落とすと操作が無駄になる。
reap_orphan_lock_holders() {
	local pids pid root age victims="" victim n=0
	pids=$(lock_open_pids)
	[ -n "$pids" ] || return 1

	for pid in $pids; do
		root=$(orphan_root "$pid") || continue
		age=$(proc_age_seconds "$root") || continue
		[ "$age" -lt "$ORPHAN_GRACE" ] && continue
		# 落とすのは起点とその配下だけ。同じロックを別のジョブも握っていたとき、
		# そちらを巻き添えにしない。
		for victim in $root $pids; do
			is_descendant "$victim" "$root" || continue
			case " $victims " in
			*" $victim "*) continue ;;
			esac
			victims="${victims:+$victims }$victim"
		done
	done
	[ -n "$victims" ] || return 1

	tty_notice "呼び出し元を失った aws login（pid ${victims}）がログインロックを握ったままです。落として先へ進みます。"
	# shellcheck disable=SC2086  # victims は pid の並びなので、単語分割がそのまま望む挙動
	kill -TERM $victims 2>/dev/null || true
	# ロックは開いている fd が全部閉じて初めて空くので、消えるまで少しだけ待つ。
	# shellcheck disable=SC2086
	while [ "$n" -lt 20 ] && any_alive $victims; do
		sleep 0.1
		n=$((n + 1))
	done
	# shellcheck disable=SC2086
	kill -KILL $victims 2>/dev/null || true
	return 0
}

# ログインロックを取る。取れたら 0、上限まで空かなければ 1。
#
# 待っている間も孤児を掃除する。待ち始めた時点では猶予の内側だった保持者が、待っている
# うちに猶予を超えることがある。
acquire_login_lock() {
	local profile="$1" waited=0
	flock -n 200 && return 0
	reap_orphan_lock_holders && flock -n 200 && return 0
	tty_notice "${profile} のログインロックを $(describe_lock_holder) が握っています。最大 ${LOGIN_LOCK_WAIT} 秒待ちます…"
	while [ "$waited" -lt "$LOGIN_LOCK_WAIT" ]; do
		flock -w "$LOCK_POLL_INTERVAL" 200 && return 0
		waited=$((waited + LOCK_POLL_INTERVAL))
		reap_orphan_lock_holders && flock -n 200 && return 0
	done
	return 1
}

portfwd_channel_available() {
	if [ -z "${LC_PORTFWD_HOST:-}" ]; then
		# 非 SSH（ローカル）では逆チャネルを使わないのが正常なので黙る。SSH セッションで
		# 空なら、オプトインしていないか sshd が LC_* を AcceptEnv していない。
		if [ -n "${SSH_CONNECTION:-}" ]; then
			tty_notice "portfwd 逆チャネル: LC_PORTFWD_HOST が空。aws login --remote へフォールバックします。"
		fi
		return 1
	fi
	local sock="${PORTFWD_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/portfwd.sock}"
	local body why
	local rc=0
	if [ ! -S "$sock" ]; then
		tty_notice "portfwd 逆チャネルが使えません: ${sock} がありません。ローカルの ssh config の RemoteForward がこのパスを指していないか、bind に失敗しています。aws login --remote へフォールバックします。"
		return 1
	fi
	# Unix domain socket へは curl でしか繋げない（bash の /dev/tcp は TCP 専用）。
	if ! command -v curl >/dev/null 2>&1; then
		tty_notice "portfwd 逆チャネルが使えません: curl がありません。aws login --remote へフォールバックします。"
		return 1
	fi
	body=$(curl -sS --unix-socket "$sock" --max-time "$PORTFWD_HEALTH_TIMEOUT" \
		http://localhost/health 2>/dev/null) || rc=$?
	if printf '%s' "$body" | grep -q '"service"[[:space:]]*:[[:space:]]*"portfwd"'; then
		return 0
	fi
	# 逆チャネルは使えない。ここで理由を出さないと --remote へ落ちた事実だけが残り、
	# 原因がどこにも残らない。切り分けは docs/portfwd-cheatsheet.md のトラブルシューティングと対応する。
	case "$rc" in
	7) why="${sock} へ接続できません。sshd は listen していますが転送先が閉じています" ;;
	52 | 56) why="${sock} が空応答です。listen はしているのでローカルの portfwd daemon が落ちています" ;;
	28) why="${sock} が ${PORTFWD_HEALTH_TIMEOUT} 秒以内に応答しません。ローカルの portfwd daemon が停止中か応答不能です" ;;
	0) why="${sock} の応答が portfwd daemon のものではありません" ;;
	*) why="${sock} の /health に失敗しました（終了コード ${rc}）" ;;
	esac
	tty_notice "portfwd 逆チャネルが使えません: ${why}。aws login --remote へフォールバックします。"
	return 1
}

# 既存セッションが「実際に有効か」を検証し、有効ならその creds を出力して終了する。
# 設定の有無ではなく STS の応答で判定するため、期限切れ/権限喪失はここを通過して
# 下のログインフローへ進む。更新は refresh_serialized で 1 プロファイル 1 本に絞る。
rc=0
refresh_serialized || rc=$?
if [ "$rc" -eq 0 ]; then
	clear_expired
	exit 0
fi
# rc=2 は STS 到達不能。有効かどうか確かめられていないので marker は触らない。
if [ "$rc" -ne 1 ]; then
	exit 0
fi

# --- 委譲: herdr の別タブでログインしてもらう ------------------------------
#
# TUI アプリ（Claude Code）は起動時に自分の配下へ AWS_LOGIN_NO_INTERACTIVE=1 を撒く。
# その中で認証切れを踏んだとき、この場でログイン UI を出すと画面が壊れる。かといって
# 黙って失敗すると、走り続けているセッションを直す手立てがない（herdr は再接続しても
# アプリを起動し直さないので、起動前チェックも効かない）。
#
# そこで herdr セッション内なら、認証用のタブを開いてそちらへ人を連れて行く。開いたタブは
# herdr サーバが起こすので AWS_LOGIN_NO_INTERACTIVE を継承せず、ふつうの端末として
# 下のログイン分岐（portfwd 逆チャネル / $BROWSER / --remote）がそのまま働く。
#
# 呼び出し元は待たせずに失敗させる。MCP の接続タイムアウトは 30 秒しかなく、人の認証を
# 待ってブロックする方が体験が悪い。認証が通れば次の呼び出しで復帰する（credential_process
# の失敗は botocore にキャッシュされない）。

# 委譲先を開き直すまでの間隔。ユーザが閉じたときに湧き続けるのを防ぐ。
HANDOFF_COOLDOWN=60

# popup を宣言している herdr プラグインの置き場所（chezmoi が配る）。
HERDR_PLUGIN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/aws-login"

# 認証が必要だと人へ知らせる。委譲先を開けたかどうかに関わらず必ず出す。開き直しを抑止した
# ときに黙ると、委譲先が残ったまま誰も気づかない状態が続く。
notify_auth_needed() {
	herdr notification show "AWS 認証が切れています" \
		--body "${1} の認証が切れました。${2}でログインしてください。" \
		--position top-right --sound request >/dev/null 2>&1 || true
}

# 既に委譲先が開いている、または閉じた直後か。
handoff_recent() {
	local marker="$1" pane_id last now
	[ -r "$marker" ] || return 1
	read -r pane_id last <"$marker" || return 1
	if [ -n "$pane_id" ] && herdr pane get "$pane_id" >/dev/null 2>&1; then
		return 0
	fi
	now=$(date +%s)
	[ -n "$last" ] && [ $((now - last)) -lt "$HANDOFF_COOLDOWN" ]
}

# 前面の popup を開いて aws-auth-handoff を走らせる。開けたら 0。
#
# popup は herdr のプラグイン pane としてしか開けず、この API に CLI が無いので herdr-api から
# 直接叩く。plugin.link は毎回貼り直す（冪等）。plugins.json はマニフェストの内容をキャッシュ
# するので、これを apply 時ではなくここでやることで、herdr サーバが後から上がった環境でも
# 自力で復旧できる。
#
# 認証したいプロファイルは env で渡す。popup のプロセスは herdr サーバの環境を継承し、そこの
# AWS_PROFILE は無関係な値なので、それに任せると別のプロファイルでログインしてしまう。
open_auth_popup() {
	local profile="$1" marker="$2" err
	command -v herdr-api >/dev/null 2>&1 || return 1
	[ -f "$HERDR_PLUGIN_DIR/herdr-plugin.toml" ] || return 1
	herdr-api plugin.link \
		"{\"path\":\"${HERDR_PLUGIN_DIR}\",\"enabled\":true}" >/dev/null 2>&1 || return 1
	if ! err=$(herdr-api plugin.pane.open \
		"{\"plugin_id\":\"aws-login\",\"entrypoint\":\"auth\",\"placement\":\"popup\",\"focus\":true,\"env\":{\"AWS_LOGIN_PROFILE\":\"${profile}\"}}" \
		2>&1 >/dev/null); then
		# 既に popup が出ている。自分が出したものなら委譲は済んでいる。他のプラグインの
		# popup なら、こちらの求めが埋もれるのでタブへ回す。
		case "$err" in
		*"popup already open"*) handoff_recent "$marker" && return 0 ;;
		esac
		return 1
	fi
	# popup は pane_id を返さないので、開いた時刻だけ残してクールダウンに使う。
	printf '%s %s\n' - "$(date +%s)" >"$marker" 2>/dev/null || true
}

# 認証タブを開いて aws-auth-handoff を走らせる。popup が開けないときのフォールバック。
open_auth_tab() {
	local profile="$1" marker="$2" out pane_id
	# herdr CLI は結果を JSON で標準出力へ書く。credential_process の標準出力は creds 専用
	# なので、必ず捕まえて漏らさない。
	out=$(herdr tab create --label "AWS login: ${profile}" --focus 2>/dev/null) || return 1
	pane_id=$(printf '%s' "$out" |
		sed -n 's/.*"pane_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
	[ -n "$pane_id" ] || return 1
	printf '%s %s\n' "$pane_id" "$(date +%s)" >"$marker" 2>/dev/null || true
	# pane run はコマンドを「そのペインへの入力」として送る。起きたばかりのシェルが
	# プロンプトを出すまで少し待つ。
	sleep 0.5
	herdr pane run "$pane_id" aws-auth-handoff "$profile" >/dev/null 2>&1 || return 1
}

# herdr へ委譲する。戻り値で委譲先が分かる。
#   0 = popup / 3 = タブ / 4 = 既に委譲済み（開き直していない） / 1 = 委譲できなかった
handoff_to_herdr() {
	local profile="$1" lock marker
	[ "${HERDR_ENV:-}" = "1" ] || return 1
	[ -n "${HERDR_SOCKET_PATH:-}" ] && [ -S "$HERDR_SOCKET_PATH" ] || return 1
	command -v herdr >/dev/null 2>&1 || return 1
	# pane run はコマンドを入力として送るので、シェルのメタ文字を含む名前は渡さない。
	case "$profile" in
	*[!A-Za-z0-9._-]* | "") return 1 ;;
	esac

	lock="$HOME/.aws/.aws-login-${profile}.handoff.lock"
	marker="$HOME/.aws/.aws-login-${profile}.handoff"
	(
		# 1 回の署名で何度も呼ばれるので、同時に走っても委譲先は 1 つに収める。
		flock -n 9 || exit 4
		if handoff_recent "$marker"; then
			notify_auth_needed "$profile" "開いている popup かタブ"
			exit 4
		fi
		if open_auth_popup "$profile" "$marker"; then
			notify_auth_needed "$profile" "前面に出た popup"
			exit 0
		fi
		if open_auth_tab "$profile" "$marker"; then
			notify_auth_needed "$profile" "開いたタブ"
			exit 3
		fi
		exit 1
	) 9>"$lock"
}

# 対話ログインを禁じられているなら、ここではログインしない。
# credential_process は TUI アプリの子プロセス（MCP サーバ等）からも呼ばれ、そこでの
# ログイン URL は画面の中へ割り込んで表示を壊す。
if [ -n "${AWS_LOGIN_NO_INTERACTIVE:-}" ]; then
	# 人にできることが無いなら誰も呼ばない。marker も置かない（statusLine に警告を出させない）。
	if ! human_login_needed; then
		log_event no-interactive "handoff=skipped"
		echo "aws-login: ${1} の認証情報を一時的に更新できませんでした。セッションは有効なので、次の呼び出しで復帰します。" >&2
		exit 1
	fi
	mark_expired
	handoff_rc=0
	handoff_to_herdr "$1" || handoff_rc=$?
	case "$handoff_rc" in
	0)
		log_event no-interactive "handoff=herdr-popup"
		echo "aws-login: ${1} は未認証です。前面に出た \"AWS login\" の popup で認証してください。" >&2
		;;
	3)
		log_event no-interactive "handoff=herdr-tab"
		echo "aws-login: ${1} は未認証です。herdr の \"AWS login: ${1}\" タブで認証してください。" >&2
		;;
	4)
		log_event no-interactive "handoff=pending"
		echo "aws-login: ${1} は未認証です。既に開いている \"AWS login\" の popup かタブで認証してください。" >&2
		;;
	*)
		log_event no-interactive "handoff=none"
		echo "aws-login: ${1} は未認証です（AWS_LOGIN_NO_INTERACTIVE のため対話ログインしません）。" >&2
		echo "           端末で aws-auth-ensure ${1} を実行してください。" >&2
		;;
	esac
	exit 1
fi

# 認証情報の取得に失敗 → flockで排他制御してログイン
(
	# まず待たずに試す。取れなければ「誰が握っているのか」を出してから待ち、居座っている
	# 孤児は落として奪う。黙って 60 秒固まると、原因がロック待ちであることすら分からない。
	if ! acquire_login_lock "$1"; then
		log_event lock-busy
		notify_error "${1} のログインロックが ${LOGIN_LOCK_WAIT} 秒待っても空きません。握っているのは $(describe_lock_holder) です。"
		exit 1
	fi
	# ロック取得後に再チェック（待っている間に別プロセスがログイン済みかもしれない）。
	# ここでも STS で実際に有効かを確認するが、creds の出力は最後の 1 箇所に集約するため
	# ここでは抑制し、判定結果（多重ログイン回避）だけを使う。
	rc=0
	emit_creds_if_valid >/dev/null 2>&1 || rc=$?
	if [ "$rc" -ne 1 ]; then
		# 待っている間に別プロセスがログインを済ませていた。
		log_event login-skipped "rc=$rc"
		exit 0
	fi
	log_event login-start

	# ローカル / SSH で認証方式を切り替える
	# （各分岐の詳細はファイル冒頭「SSH 先での挙動」を参照）。
	# portfwd 逆チャネルの判定は 1 回だけ行いキャッシュする（到達性確認の二重実行を避ける）。
	portfwd_ok=""
	if portfwd_channel_available; then portfwd_ok=1; fi

	if [[ -n $portfwd_ok ]]; then
		# portfwd 逆チャネルあり。$BROWSER=portfwd-open がローカルのブラウザを開き、
		# localhost コールバックは SOCKS5 リレー経由で SSH 先の loopback へ戻る。
		if { : >/dev/tty; } 2>/dev/null; then
			aws login </dev/tty >/dev/tty 2>&1
		else
			aws login
		fi
	elif [[ -n $BROWSER && $BROWSER != portfwd-open && $BROWSER != */portfwd-open ]]; then
		# VSCode Remote 等、$BROWSER 経由でローカルのブラウザを開ける環境。
		# ポートフォワードで localhost コールバックも戻るので --remote は付けない。
		#
		# portfwd-open だけは除外する。.zshenv は LC_PORTFWD_HOST があるだけで $BROWSER を
		# portfwd-open に向けるので、逆チャネルが死んでいてもここへ落ちてくる。そのまま
		# コールバック方式で進むと portfwd-open が非ゼロ終了して認証が完結しないため、
		# 下の --remote へ流す。
		#
		# VSCode の $BROWSER ヘルパ（browser.sh → 同梱 node で server-cli.js を実行）は
		# 内部で url.parse() を使っており、Node が DEP0169 の DeprecationWarning を
		# stderr に出す。ログインには無害なノイズなので、ヘルパを起動するこの分岐に限って
		# --no-deprecation で黙らせる（既存の $NODE_OPTIONS は保持する）。
		node_opts="${NODE_OPTIONS:+$NODE_OPTIONS }--no-deprecation"
		if { : >/dev/tty; } 2>/dev/null; then
			NODE_OPTIONS="$node_opts" aws login </dev/tty >/dev/tty 2>&1
		else
			NODE_OPTIONS="$node_opts" aws login
		fi
	elif [[ -n $SSH_CONNECTION ]] && { : >/dev/tty; } 2>/dev/null; then
		# SSH。URL 表示＋コード貼り付け方式で、制御端末へ直結する。
		aws login --remote </dev/tty >/dev/tty 2>&1
	elif [[ -n $SSH_CONNECTION ]]; then
		aws login --remote
	else
		# ローカル。ブラウザでの認証（従来どおり）。
		unset DISPLAY
		aws login
	fi
) 200>"$LOGIN_LOCK"

# ログイン直後（または上のロック内で別プロセスがログイン済みと判明した）creds を出力する。
# 出力をこの 1 箇所に集約しているので、credential_process の stdout に JSON が二重に出ない。
# creds を取れなければログインは完結していない。コマンド置換を引数へ直に書くと失敗を
# 見逃すので、変数に受けて確かめてから出力する（空のまま 0 で終わると、呼び出し元は
# ログインできたものとして先へ進む）。
creds=$(aws configure export-credentials --format process) || creds=""
if [ -z "$creds" ]; then
	mark_expired
	log_event login-fail
	notify_error "${1} の認証情報を取得できませんでした。ログインが完了していません。"
	exit 1
fi
log_event login-ok
emit_creds "$creds"
clear_expired
