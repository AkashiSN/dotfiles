#!/usr/bin/env python3
"""portfwd - SSH 先のブラウザ起動をローカルへ転送するローカル daemon.

リモートの portfwd-open シムが RemoteForward 経由で 127.0.0.1:55999 へ
{"host","url"} を POST する。daemon は url の callback ポートをローカルで listen し、
その ssh 接続の DynamicForward(SOCKS5) を通してリモートの同じポートへ中継したうえで、
ローカルのブラウザを開く。

daemon の寿命は OS のサービスマネージャ（macOS は launchd、Windows はタスクスケジューラ）
が管理する。ログイン時に起動し、落ちても再起動されるため、このスクリプト自身は
アイドル自己終了や多重起動制御を持たない。

サブコマンド:
  serve   : 55999 で listen する常駐ループ（サービスマネージャが起動する本体）
  status  : 稼働状況を表示（GET /health の応答で判定）
"""
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

PORT = int(os.environ.get("PORTFWD_PORT", "55999"))
# 未設定なら OS ごとの既定を使う（darwin=open / windows=os.startfile / それ以外=xdg-open）。
OPEN_CMD = os.environ.get("PORTFWD_OPEN_CMD")
SSH_CMD = os.environ.get("PORTFWD_SSH_CMD", "ssh")


def _default_log_path():
    """Windows は pythonw.exe が stderr を捨てるため、既定のログファイルを持つ。
    macOS/Linux はサービスマネージャがログを取るので既定は持たない。"""
    override = os.environ.get("PORTFWD_LOG")
    if override:
        return Path(override)
    if os.name == "nt":
        base = os.environ.get("LOCALAPPDATA")
        if base:
            return Path(base) / "portfwd" / "portfwd.log"
    return None


LOG_PATH = _default_log_path()

# SOCKS5 のネゴシエーションに使う timeout。確立後の中継はこれを外して blocking へ戻す
# （間の空く通信を切らないため）。
HANDSHAKE_TIMEOUT = 5.0
# リレーの listener を畳むまでのアイドル時間。
IDLE_TIMEOUT = 180.0
# accept の待ち時間。listener.close() が別スレッドの blocking accept を解除することは
# （特に Windows で）保証されないため、自前で抜けられるように timeout を張る。
ACCEPT_TIMEOUT = 1.0
# ssh -G の待ち時間。Match exec を含む config では解決に時間がかかりうる。
SSH_G_TIMEOUT = 10.0
# Windows でのみ有効な値。daemon は pythonw.exe（コンソール無し）で動くため、素の
# subprocess.run で ssh.exe を起動するとコンソールウィンドウが通知のたびに生成される。
# 非 Windows には無い定数なので getattr で参照し、import 自体は失敗させない。
_CREATE_NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0)


def _log(msg):
    line = f"portfwd: {msg}"
    try:
        print(line, file=sys.stderr, flush=True)
    except (AttributeError, OSError, ValueError):
        # stderr が None または書き込み不可でも daemon を止めない。
        pass
    if LOG_PATH is None:
        return
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as f:
            f.write(line + "\n")
    except (AttributeError, OSError, ValueError):
        # ログファイルに書けないことで daemon を止めない。
        pass


def _recv_exact(sock, n):
    """n バイト受け取るまで読む。recv は要求より短く返しうるため必ずこれを使う。"""
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError(f"接続が {len(buf)}/{n} バイトで切れました")
        buf += chunk
    return buf


def _socks_greet(sock):
    """SOCKS5 の認証ネゴシエーション（認証なし）を行う。"""
    sock.sendall(b"\x05\x01\x00")
    reply = _recv_exact(sock, 2)
    if reply != b"\x05\x00":
        raise ConnectionError(f"SOCKS5 greeting が不正です ({reply.hex()})")


def _socks_probe(socks_port):
    """socks_port で SOCKS5 サービスが応答するかを確かめる。

    保証するのは「その loopback ポートで SOCKS5 が応答中」までで、それが対象ホストの
    ssh 接続のものであることまでは確かめない（別プロセスが同じポートを掴んでいても通る）。
    setenv によるオプトイン検証とホストごとの固定ポートと組み合わせて使う。
    """
    try:
        with socket.create_connection(("127.0.0.1", socks_port), HANDSHAKE_TIMEOUT) as s:
            s.settimeout(HANDSHAKE_TIMEOUT)
            _socks_greet(s)
        return True
    except (OSError, ConnectionError):
        return False


def _socks_connect(socks_port, dst_port):
    """SOCKS5 CONNECT でリモートの 127.0.0.1:dst_port へ繋ぎ、確立済みソケットを返す。

    SOCKS プロキシは接続先を SSH サーバ側から解決するため、127.0.0.1 はリモートの
    loopback を指す。これが ssh -L dst_port:127.0.0.1:dst_port と等価になる。
    """
    s = socket.create_connection(("127.0.0.1", socks_port), HANDSHAKE_TIMEOUT)
    try:
        s.settimeout(HANDSHAKE_TIMEOUT)
        _socks_greet(s)
        s.sendall(b"\x05\x01\x00\x01" + socket.inet_aton("127.0.0.1")
                  + dst_port.to_bytes(2, "big"))
        ver, rep, rsv, atyp = _recv_exact(s, 4)
        if ver != 5 or rsv != 0:
            raise ConnectionError(f"SOCKS5 応答が不正です (ver={ver} rsv={rsv})")
        if rep != 0:
            raise ConnectionError(f"SOCKS5 CONNECT を拒否されました (rep={rep})")
        # BND.ADDR / BND.PORT を読み捨てる。
        if atyp == 1:
            _recv_exact(s, 4 + 2)
        elif atyp == 3:
            _recv_exact(s, _recv_exact(s, 1)[0] + 2)
        elif atyp == 4:
            _recv_exact(s, 16 + 2)
        else:
            raise ConnectionError(f"SOCKS5 応答の ATYP が不正です ({atyp})")
        s.settimeout(None)
        return s
    except Exception:
        s.close()
        raise


# callback ポート -> Relay。ロックで保護する。
_relays = {}
_relays_lock = threading.Lock()


class Relay:
    """ローカル 127.0.0.1:port で受けた接続を、SOCKS5 経由でリモートの
    127.0.0.1:port へ中継する。ssh -L port:127.0.0.1:port の置き換え。"""

    def __init__(self, host, port, socks_port):
        self.host = host
        self.port = port
        self.socks_port = socks_port
        self.last_activity = time.monotonic()
        self._stop = threading.Event()
        self.listener = socket.socket()
        # macOS/Linux の SO_REUSEADDR は TIME_WAIT の再バインドのみ許可し、他プロセスが
        # listen 中のポートへは bind を拒否する。Windows ではこの保証がなく、別のソケットが
        # 実際に listen 中のポートへの bind も許してしまうため、ここで設定しない。
        if sys.platform != "win32":
            self.listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            # IPv4 loopback のみで listen する。callback には localhost も許容しているため、
            # ブラウザが localhost を ::1 に解決する環境では bind 先が無く弾かれうる
            # （aws login / gh auth は 127.0.0.1 を返すため今のところ未発生）。
            self.listener.bind(("127.0.0.1", port))
            self.listener.listen(16)
        except OSError:
            self.listener.close()
            raise
        self.listener.settimeout(ACCEPT_TIMEOUT)
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def close(self):
        self._stop.set()
        try:
            self.listener.close()
        except OSError:
            pass

    def _accept_loop(self):
        while not self._stop.is_set():
            try:
                conn, _ = self.listener.accept()
            except socket.timeout:
                if time.monotonic() - self.last_activity > IDLE_TIMEOUT:
                    if not _unregister_relay(self):
                        continue
                    return
                continue
            except OSError:
                return
            self.last_activity = time.monotonic()
            threading.Thread(target=self._handle, args=(conn,), daemon=True).start()

    def _handle(self, conn):
        try:
            upstream = _socks_connect(self.socks_port, self.port)
        except (OSError, ConnectionError) as e:
            # リレー確立後に起きるため通知には 200 を返済み。呼び出し側のフォールバックには
            # 繋がらないので、ログに残してこの接続だけ閉じる。
            _log(f"relay {self.port}: SOCKS CONNECT 失敗 ({e})")
            conn.close()
            return
        pump = threading.Thread(target=self._pump, args=(upstream, conn), daemon=True)
        pump.start()
        self._pump(conn, upstream)
        pump.join()
        for sock in (conn, upstream):
            try:
                sock.close()
            except OSError:
                pass

    def _pump(self, src, dst):
        try:
            while True:
                data = src.recv(65536)
                if not data:
                    break
                dst.sendall(data)
                self.last_activity = time.monotonic()
        except OSError:
            pass
        finally:
            # 片側が EOF に達したことを相手へ伝える。伝えないと、応答前に全入力を読み切る
            # 相手（OAuth の callback サーバ等）が永久に待つ。
            try:
                dst.shutdown(socket.SHUT_WR)
            except OSError:
                pass


def _unregister_relay(relay):
    """アイドルで畳んだ Relay を登録から外す。同じポートに新しい Relay が入っている
    場合や、別スレッドが last_activity を更新した場合は削除しない。True を返したら畳み
    成功、False を返したら畳まなかった（他スレッドが再利用中）。"""
    with _relays_lock:
        # identity と freshness の両方を確認してから削除。ensure_relay が last_activity を
        # 更新した場合は、アイドル判定は古い状態のままだが、ロック内で再確認すれば
        # 新しい last_activity を見る。
        if _relays.get(relay.port) is relay and time.monotonic() - relay.last_activity > IDLE_TIMEOUT:
            del _relays[relay.port]
            relay.close()
            _log(f"relay {relay.port}: アイドルのため終了 (via {relay.host})")
            return True
    return False


def ensure_relay(host, port, socks_port):
    """port のリレーを用意する。成功なら None、失敗なら reject メッセージを返す。"""
    with _relays_lock:
        existing = _relays.get(port)
        if existing is not None:
            if existing.host != host:
                # 張り替えると、先行フローのブラウザ callback を後発ホストへ誤配送して
                # しまう。奪わずに reject し、呼び出し側を従来動作へフォールバックさせる。
                return f"reject: ポート {port} は {existing.host} のリレーが使用中です"
            existing.last_activity = time.monotonic()
            return None
        try:
            _relays[port] = Relay(host, port, socks_port)
        except OSError as e:
            return f"reject: 127.0.0.1:{port} を listen できません ({e})"
    return None


def _ssh_config(host):
    """ssh -G <host> の解決結果を {key: [value, ...]} で返す。失敗時は None。

    ssh -G は接続せず設定を解決するだけだが、Match exec は評価される。
    """
    try:
        proc = subprocess.run(
            [SSH_CMD, "-G", host],
            capture_output=True, text=True, timeout=SSH_G_TIMEOUT,
            creationflags=_CREATE_NO_WINDOW,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        _log(f"ssh -G {host}: {e}")
        return None
    if proc.returncode != 0:
        _log(f"ssh -G {host}: 終了コード {proc.returncode} ({proc.stderr.strip()})")
        return None
    conf = {}
    for line in proc.stdout.splitlines():
        key, _, value = line.partition(" ")
        conf.setdefault(key.lower(), []).append(value)
    return conf


def _socks_port_of(conf):
    """dynamicforward から SOCKS ポートを取り出す。(port, エラーメッセージ) を返す。

    ssh -G の書式は bind address 無しなら "55888"、有りなら "[127.0.0.1]:55888"。
    DynamicForward は複数指定できるため、一意に決まることを確かめる。
    """
    values = conf.get("dynamicforward", [])
    if not values:
        return None, "dynamicforward が設定されていません"
    if len(values) > 1:
        return None, f"dynamicforward が {len(values)} 個あり一意に決まりません"
    bind, sep, port = values[0].rpartition(":")
    if not sep:
        return None, f"dynamicforward に bind address がありません ({values[0]})"
    if not port.isdigit():
        return None, f"dynamicforward の書式が不正です ({values[0]})"
    if bind.strip("[]") != "127.0.0.1":
        return None, f"dynamicforward が IPv4 loopback ではありません ({values[0]})"
    return int(port), None


def _callback_endpoint(parsed):
    """ブラウザ URL から、ローカルへ -L 転送すべき callback (host, port) を決める。

    2 パターンに対応する:
      1. OAuth/OIDC の authorize URL（例: `aws login` / `gh auth`）。ブラウザが開くのは
         認可サーバ上の URL で、コールバックは `redirect_uri` クエリに localhost:port
         として埋め込まれる（URL 自身のホストは認可サーバなので localhost ではない）。
      2. URL 自体が localhost:port のコールバック（ツールが直接ローカル URL を開く場合）。
    どちらでもないときは (None, None) を返す（呼び出し側は転送せず、URL を開くだけにする）。
    """
    # 1) authorize URL: redirect_uri クエリのローカルコールバックを最優先で使う。
    redirect = parse_qs(parsed.query).get("redirect_uri", [None])[0]
    if redirect:
        r = urlparse(redirect)
        if r.hostname in ("127.0.0.1", "localhost") and r.port:
            return r.hostname, r.port
    # 2) URL 自体がローカルコールバックのとき。
    if parsed.hostname in ("127.0.0.1", "localhost") and parsed.port:
        return parsed.hostname, parsed.port
    return None, None


def _open_url(url):
    """ローカルのブラウザで URL を開く。"""
    if OPEN_CMD:
        subprocess.run([OPEN_CMD, url],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if sys.platform == "darwin":
        subprocess.run(["open", url],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif os.name == "nt":
        os.startfile(url)  # noqa: S606  Windows の既定ブラウザで開く
    else:
        subprocess.run(["xdg-open", url],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def handle_notification(payload: dict) -> str:
    """1 通知を処理し、結果メッセージを返す。例外は投げず "ok:" / "reject:" / "error:"
    で始まる文字列で返す（do_POST が prefix で HTTP ステータスを決める）。"""
    host = payload.get("host")
    url = payload.get("url")
    if not host or not url:
        return "reject: host/url がありません"
    try:
        if not re.fullmatch(r'[A-Za-z0-9._-]+', host):
            return f"reject: 不正な host ({host})"
        parsed = urlparse(url)
        # http/https のみ開く（file:// や javascript: などの踏み台化を防ぐ）。
        if parsed.scheme not in ("http", "https"):
            return f"reject: 非対応スキーム ({parsed.scheme or 'なし'})"

        # ssh config 上で明示的にオプトインされたホストか確かめる。SetEnv で送っている
        # LC_PORTFWD_HOST が通知の host と一致することが条件。callback の有無に関わらず必須。
        conf = _ssh_config(host)
        if conf is None:
            return f"reject: ssh -G {host} が失敗しました"
        if f"LC_PORTFWD_HOST={host}" not in conf.get("setenv", []):
            return f"reject: {host} は portfwd 対象ではありません (SetEnv 不一致)"

        # localhost callback を伴う URL（OAuth の authorize URL 等）のときだけ、その callback
        # ポートをリレーする。普通の URL（callback 無し）は転送せず、ローカルで開くだけ。
        _, cb_port = _callback_endpoint(parsed)
        if cb_port is not None and not (1 <= cb_port <= 65535):
            return f"reject: callback ポートが範囲外です ({cb_port})"
        if cb_port:
            socks_port, err = _socks_port_of(conf)
            if err:
                return f"reject: {host}: {err}"
            if not _socks_probe(socks_port):
                return f"reject: {host}: SOCKS プロキシ 127.0.0.1:{socks_port} が応答しません"
            rejected = ensure_relay(host, cb_port, socks_port)
            if rejected:
                return rejected

        # ローカルブラウザで開く（authorize URL なら認可ページ、普通の URL ならそのページ）。
        _open_url(url)
        relayed = f"relay {cb_port} " if cb_port else ""
        return f"ok: {relayed}via {host}, opened {url}"
    except Exception as e:
        return f"error: {e}"


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        # /health だけを受ける。他のパスは 404（このポートは通知専用で、汎用の
        # HTTP サーバとして振る舞わせない）。
        if self.path != "/health":
            self.send_response(404)
            self.end_headers()
            return
        with _relays_lock:
            relays = len(_relays)
        # pid は出さない。逆チャネル経由でリモート側からも読めるため。
        body = json.dumps({"service": "portfwd", "relays": relays}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length) if length else b""
        try:
            payload = json.loads(raw.decode() or "{}")
        except json.JSONDecodeError:
            self.send_response(400)
            self.end_headers()
            return
        result = handle_notification(payload)
        _log(result)
        # ok のみ 200。reject/error は 4xx で返し、portfwd-open の `curl -f` を失敗させて
        # 呼び出し側（aws login 等）を従来動作（--remote 等）へフォールバックさせる。
        self.send_response(200 if result.startswith("ok:") else 422)
        self.end_headers()
        self.wfile.write(result.encode())

    def log_message(self, *_):  # アクセスログ抑制
        pass


class _NotificationServer(HTTPServer):
    """逆チャネル（POST 通知）を受ける HTTPServer。

    HTTPServer は既定で allow_reuse_address = 1 だが、Windows の SO_REUSEADDR は
    他プロセスが実際に listen 中のポートへの bind も許してしまう（Relay が
    SO_REUSEADDR を設定しない理由と同じ）。Relay と挙動を揃えるため、Windows でのみ
    無効にする。
    """

    allow_reuse_address = sys.platform != "win32"


def cmd_serve():
    # launchd が本体として起動する。listen に失敗（既に誰かが掴んでいる等）したら
    # 非ゼロ終了し、launchd の ThrottleInterval に従って後で再試行させる。
    try:
        httpd = _NotificationServer(("127.0.0.1", PORT), Handler)
    except OSError as e:
        _log(f"listen 失敗 ({PORT}): {e}")
        sys.exit(1)
    _log(f"listen 127.0.0.1:{PORT} (pid {os.getpid()})")
    httpd.serve_forever()


def cmd_status():
    """GET /health の応答で生死を判定する。ポートが開いているかだけでは、他プロセスが
    掴んでいる場合に running と誤判定するため。"""
    url = f"http://127.0.0.1:{PORT}/health"
    try:
        with urllib.request.urlopen(url, timeout=2.0) as res:
            payload = json.loads(res.read().decode())
    except urllib.error.HTTPError:
        print(f"portfwd: not-portfwd (port {PORT} は別のサービスが応答しています)")
        return
    except (urllib.error.URLError, TimeoutError, socket.timeout) as e:
        reason = getattr(e, "reason", e)
        if isinstance(reason, (TimeoutError, socket.timeout)):
            # 通知処理中の ssh -G で待たされている可能性があるため、停止と断定しない。
            print(f"portfwd: timeout / unresponsive (port {PORT})")
        else:
            print(f"portfwd: stopped (port {PORT})")
        return
    except (json.JSONDecodeError, http.client.IncompleteRead):
        # 応答本文が JSON ではない、または読み取り途中で接続を閉じられた。
        print(f"portfwd: not-portfwd (port {PORT} は別のサービスが応答しています)")
        return
    # payload が dict でない（配列や文字列など）場合も not-portfwd として扱う。
    if not isinstance(payload, dict) or payload.get("service") != "portfwd":
        print(f"portfwd: not-portfwd (port {PORT} は別のサービスが応答しています)")
        return
    print(f"portfwd: running (port {PORT}, relays {payload.get('relays', 0)})")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    {"serve": cmd_serve, "status": cmd_status}.get(cmd, cmd_status)()


if __name__ == "__main__":
    main()
