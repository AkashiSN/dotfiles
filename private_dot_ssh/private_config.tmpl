Host *
    ServerAliveInterval 1200
    ServerAliveCountMax 12
    TCPKeepAlive        yes
    Compression         yes
    IdentitiesOnly      yes
{{- if eq .chezmoi.os "windows" }}
    # Windows では Microsoft OpenSSH が固定パイプ \\.\pipe\openssh-ssh-agent で
    # 待ち受け、1Password の agent がそれを乗っ取るため IdentityAgent の指定は不要。
{{- else }}
    IdentityAgent       ~/.1password/agent.sock
{{- end }}

# Suita
Host gw-suita
    HostName        gw-suita.akashisn.info
    ProxyCommand    cloudflared access ssh --hostname %h
    User            admin
    ForwardAgent    yes
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

Host ix2215-suita
    HostName        172.16.0.1
    User            nishi
    HostKeyAlgorithms ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa

Host er-x-suita
    HostName        172.16.0.2
    User            nishi
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

Host truenas-suita
    HostName        172.16.0.3
    User            admin
    ForwardAgent    yes
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

# Tokyo
Host gw-tokyo
    HostName        gw-tokyo.akashisn.info
    ProxyCommand    cloudflared access ssh --hostname %h
    User            admin
    ForwardAgent    yes
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

Host ix2215-tokyo
    HostName        172.16.100.1
    User            nishi
    HostKeyAlgorithms ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa

Host develop-server
    HostName        develop-server
    User            ubuntu
    IdentityFile    ~/.ssh/1password_AkashiSN.pub
    DynamicForward  127.0.0.1:55887
    SetEnv          LC_PORTFWD_HOST=develop-server
{{- if eq .chezmoi.os "windows" }}
    RemoteForward   127.0.0.1:55999 127.0.0.1:55999
{{- else }}
    Tag             portfwd
{{- end }}

Host truenas
    HostName        truenas
    User            admin
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

# AWS
Host cloudsa
    HostName        i-0125c81b19f9acbac
    User            ec2-user
    ForwardAgent    yes
    IdentityFile    ~/.ssh/1password_AkashiSN.pub
    DynamicForward  127.0.0.1:55888
    SetEnv          LC_PORTFWD_HOST=cloudsa
{{- if eq .chezmoi.os "windows" }}
    ProxyCommand    "{{ .chezmoi.homeDir | replace "\\" "/" }}/.ssh/ssm-proxy.bat" %h %p %r cdx-arise-pre-dev
    RemoteForward   127.0.0.1:55999 127.0.0.1:55999
{{- else }}
    ProxyCommand    ~/.ssh/ssm-proxy.sh %h %p %r cdx-arise-pre-dev
    Tag             portfwd
{{- end }}

# Service
Host gitlab.com
    HostName        gitlab.com
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

# github.com はアカウントごとに鍵を使い分ける。
# デフォルト（github.com）と github.com-AkashiSN は AkashiSN の鍵。
# 別アカウントは git@github.com-<user>:owner/repo.git の形で remote を指定する。
Host github.com github.com-AkashiSN
    HostName        github.com
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

Host github.com-su-nishi
    HostName        github.com
    IdentityFile    ~/.ssh/1password_su-nishi.pub

Host gist.github.com
    HostName        github.com
    IdentityFile    ~/.ssh/1password_AkashiSN.pub

{{- if ne .chezmoi.os "windows" }}
# portfwd: タグ付きホストの逆チャネル（docs/portfwd-cheatsheet.md）。
# 動的フォワードは daemon が DynamicForward(SOCKS5) 経由で張るため、ここでは
# 逆チャネルだけを設定する。ControlMaster は ssh 接続を再利用するための設定。
Match tagged portfwd
    ControlMaster    auto
    ControlPath      ~/.ssh/cm-%n
    ControlPersist   10m
    RemoteForward    127.0.0.1:55999 127.0.0.1:55999
{{- end }}

# Match
{{- if eq .chezmoi.os "windows" }}
Match host 172.16.0.* !Exec "ping -n 1 -w 1000 172.16.0.1"
    ProxyJump gw-suita

Match host 172.16.100.* !Exec "ping -n 1 -w 1000 172.16.100.1"
    ProxyJump gw-tokyo
{{- else }}
Match host 172.16.0.* !Exec "ping -c1 -t1 172.16.0.1"
    ProxyJump gw-suita

Match host 172.16.100.* !Exec "ping -c1 -t1 172.16.100.1"
    ProxyJump gw-tokyo
{{- end }}
