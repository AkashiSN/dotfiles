{{- /* chezmoi データ未設定（chezmoi init 前）でも既定値で展開する */ -}}
{{- $name := dig "git" "name" "AkashiSN" . -}}
{{- $email := dig "git" "email" "btorntireinvynriy@gmail.com" . -}}
{{- $signingkey := dig "git" "signingkey" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICnhzqXkGkWLreU4JcDWCAH+8P47Sj5a2iMPCEZa4sip" . -}}
[core]
	autocrlf = input
	editor = nvim
	excludesfile = ~/.gitignore_global
	ignorecase = false

[alias]
	# AI でステージ済みの変更からコミットメッセージを生成 (~/.local/bin/git-aicommit)
	aicommit = "!git-aicommit"

[color]
	ui = true

{{- if and $signingkey (eq .chezmoi.os "darwin") }}

[commit]
	gpgsign = true
{{- end }}

{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}

# 共有の Homebrew（別ユーザ所有）の git を dubious ownership で拒まないようにする
[safe]
	directory = /opt/homebrew
	directory = /opt/homebrew/Library/Taps/*
{{- end }}

[ghq]
	root = ~/Project/src

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pull]
	rebase = false

[user]
	name = {{ $name }}
	email = {{ $email }}
{{- if $signingkey }}
	signingkey = {{ $signingkey }}
{{- end }}

[gpg]
	format = ssh

{{- if and $signingkey (eq .chezmoi.os "darwin") }}

[gpg "ssh"]
	program = "op-ssh-sign"
	allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

[url "https://"]
	insteadOf = git://

# https:// で書かれた clone/remote を SSH 経由に寄せる
[url "git@github.com:"]
	insteadOf = https://github.com/

[init]
	defaultBranch = main

[push]
	followTags = true
