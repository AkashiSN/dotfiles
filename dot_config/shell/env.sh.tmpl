# ~/.config/shell/env.sh — zsh / bash 共通の環境変数。POSIX sh で書く。
#
# なぜ共有するのか:
#   ログインシェルは zsh だが、Claude Code は CLAUDE_CODE_SHELL=/bin/bash で bash を走らせる。
#   通常はどちらも親プロセスから env を継承するので差は出ないが、継承が効かない起動経路が
#   ある(agmsg の spawn.sh / VS Code・Kiro 拡張の spawn / chezmoi の run_ スクリプト)。
#   そこだけ PATH もツールの環境変数も無い素の環境になるため、env の土台をここへ一本化する。
#
#   ここがカバーするのは PATH とツールの env(AQUA_* / TF_PLUGIN_CACHE_DIR など)だけ。
#   AWS_PROFILE / MO_PORT のような ~/.env 由来の値はここでは設定されず、~/.env も読まない
#   (direnv と、親プロセスからの継承の領域)。
#
# 置いてよいもの: 環境変数と PATH だけ。
# 置いてはいけないもの: 補完 / prompt / キーバインド / ZLE / alias。それらは対話専用で、
#   zsh 側(~/.config/zsh/rc.d/)にある。alias は両シェル共有の aliases.sh。
#
# 冪等であること:
#   ~/.zshenv と ~/.bashrc の両方から読まれ、Claude のシェルスナップショットでも読まれる
#   ため、複数回 source されうる。_prepend が既出を弾くので PATH は伸びない。
#
# 詳細は docs/zsh-cheatsheet.md の「シェルの役割分担」。
# shellcheck shell=sh

# PATH 形式の変数の先頭へ値を足す。既に含まれていれば何もしない(冪等)。
# 既存の値の順序は変えない。MANPATH / INFOPATH のように「空要素＝システム既定」の
# 意味を持つ変数に使うので、要素を組み替えない実装にしてある。
# 使い方: _prepend MANPATH "$HOME/.local/share/man"
_prepend() {
	eval "_pp_cur=\${$1:-}"
	# shellcheck disable=SC2154  # eval で動的代入しているため shellcheck には見えない
	case ":$_pp_cur:" in
	*":$2:"*)
		unset _pp_cur
		return 0
		;;
	esac
	eval "$1=\"\$2\${_pp_cur:+:\$_pp_cur}\""
	# shellcheck disable=SC2163  # $1 は呼び出し側が渡す変数名
	export "$1"
	unset _pp_cur
}

# PATH の先頭へディレクトリを置く。既に後方にあれば**取り除いてから**先頭へ置き直す
# (zsh の typeset -U path と同じ move-to-front)。
#
# 「既出なら何もしない」にはできない。~/.zshenv が先に走らせる path_helper が
# /etc/paths.d 由来の /opt/homebrew/bin を PATH の後方へ入れるため、何もしないと
# Homebrew のコマンドがシステム標準(/usr/bin)より後ろに残り、git などが macOS 同梱の
# 版に解決されてしまう。
#
# PATH の空要素はカレントディレクトリを意味する危険な指定なので、組み替えで消えても
# 困らない(MANPATH / INFOPATH は _prepend の側を使う)。
_path_add() {
	_pa_cur=":${PATH:-}:"
	while :; do
		case "$_pa_cur" in
		*":$1:"*) _pa_cur="${_pa_cur%%:"$1":*}:${_pa_cur#*:"$1":}" ;;
		*) break ;;
		esac
	done
	_pa_cur="${_pa_cur#:}"
	_pa_cur="${_pa_cur%:}"
	PATH="$1${_pa_cur:+:$_pa_cur}"
	export PATH
	unset _pa_cur
}

# 存在するディレクトリだけを PATH の先頭へ置く。zsh の `path=( dir(N-/) )` に相当する。
_path_prepend() {
	[ -d "$1" ] || return 0
	_path_add "$1"
}

# システム標準パスの取りこぼしを埋める用。既にあれば位置を変えない(path_helper が
# /etc/paths の順で入れた並びを尊重する)。
_path_fallback() {
	[ -d "$1" ] || return 0
	_prepend PATH "$1"
}

# 存在するディレクトリだけを MANPATH の先頭へ足す。
_man_prepend() {
	[ -d "$1" ] || return 0
	_prepend MANPATH "$1"
}

# MANPATH は「空の要素の位置にシステム既定を挿入する」という意味論を man が持つ。
# 未設定のまま自前のパスを入れると、その空要素が無くなってシステム既定がまるごと
# 置き換わり、`man ls` のような標準マニュアルが引けなくなる。そこで最後に末尾へ
# コロンを足す。先に MANPATH=":" を代入してはいけない: zsh は MANPATH を配列 manpath と
# tie しており ~/.zshenv で typeset -U を掛けているため、空文字列 1 要素だけの配列は
# 重複排除で潰れて MANPATH が完全な空文字列になる。実パスを入れた後なら潰れない。
_man_was_empty=0
[ -z "${MANPATH:-}" ] && _man_was_empty=1
_info_was_empty=0
[ -z "${INFOPATH:-}" ] && _info_was_empty=1

export LANG=ja_JP.UTF-8

# エディタ: 環境変数なので全シェル/スクリプトに効かせる(rc.d は対話限定なので取りこぼす。
# herdr --remote で非対話な ssh セッションからサーバを起動しても、ここは読まれる)。
export EDITOR=nvim
export VISUAL=nvim

# システム標準パス。PATH が空の起動経路(chezmoi の run_ スクリプト等)でも最低限
# ここが通るようにする。既にあるものは動かさないので、macOS で path_helper が
# /etc/paths の順に入れた並びはそのまま。呼ぶ順と PATH 上の順は逆になる。
_path_fallback /bin
_path_fallback /sbin
_path_fallback /usr/bin
_path_fallback /usr/sbin
_path_fallback /usr/local/bin
_path_fallback /usr/local/sbin

{{ if eq .chezmoi.arch "arm64" -}}
HOMEBREW_PATH=/opt/homebrew
{{- else -}}
HOMEBREW_PATH=/usr/local
{{- end }}
export HOMEBREW_PATH
_path_prepend "$HOMEBREW_PATH/sbin"
_path_prepend "$HOMEBREW_PATH/bin"
_man_prepend "$HOMEBREW_PATH/share/man"

# GNU 版のコマンドを macOS 同梱の BSD 版より前に置く(Homebrew の keg-only パッケージ)。
# _path_prepend は先頭へ足すので、PATH 上の並びはここに書いた順の逆になる。
# 先頭に来てほしい coreutils を最後に呼ぶ。
_path_prepend "$HOMEBREW_PATH/opt/curl/bin"
_path_prepend "$HOMEBREW_PATH/opt/unzip/bin"
for _pkg in grep gnu-tar gnu-sed gawk findutils ed coreutils; do
	_path_prepend "$HOMEBREW_PATH/opt/$_pkg/libexec/gnubin"
done
_man_prepend "$HOMEBREW_PATH/opt/curl/share/man"
_man_prepend "$HOMEBREW_PATH/opt/unzip/share/man"
for _pkg in grep gnu-tar gnu-sed gawk findutils ed coreutils; do
	_man_prepend "$HOMEBREW_PATH/opt/$_pkg/libexec/gnuman"
done
unset _pkg

# aqua - Declarative CLI Version Manager (https://aquaproj.github.io/)
export AQUA_REMOVE_MODE=pl
export AQUA_ROOT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua"
export AQUA_GLOBAL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/aqua.yaml"
export AQUA_POLICY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/aqua-policy.yaml"
_path_prepend "$AQUA_ROOT_DIR/bin"

# rust - toolchain は rustup(aqua 管理)で導入。cargo/rustc プロキシは CARGO_HOME/bin。
# 実際の toolchain 導入は run_onchange の 32-rust-default が rustup-init で行う。
export RUSTUP_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/rustup"
export CARGO_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/cargo"
_path_prepend "$CARGO_HOME/bin"

# ~/.local/bin - chezmoi が配る自作スクリプト、uv tool のバイナリ、uv が --default で置く
# python/python3。/usr/bin より前に来るので、python3 は macOS 同梱の 3.9 ではなく uv が
# 入れた版になる。
export LOCAL_PREFIX="$HOME/.local"
_path_prepend "$LOCAL_PREFIX/bin"

# 開発系パス。Claude がビルドを走らせたときにユーザと同じものを引くよう、対話 rc ではなく
# ここに置く。ディレクトリが無くても害はないので存在確認しない。
_prepend MANPATH "$LOCAL_PREFIX/share/man"
_prepend INFOPATH "$LOCAL_PREFIX/share/info"
# 以下の 5 つには MANPATH のような末尾コロンを足さない。動的リンカ・プリプロセッサ・
# pkg-config にとって空要素は「カレントディレクトリ」を意味するため、カレントディレクトリの
# ライブラリ/ヘッダを意図せず拾う経路ができてしまう。
_prepend LD_LIBRARY_PATH "$LOCAL_PREFIX/lib"
_prepend LIBRARY_PATH "$LOCAL_PREFIX/lib"
_prepend PKG_CONFIG_PATH "$LOCAL_PREFIX/lib/pkgconfig"
_prepend C_INCLUDE_PATH "$LOCAL_PREFIX/include"
_prepend CPLUS_INCLUDE_PATH "$LOCAL_PREFIX/include"

# terraform - provider をユーザー共通のキャッシュへ置き、プロジェクトごとの再ダウンロードを
# 避ける。同じパスを ~/.terraformrc の plugin_cache_dir にも書いてあり(シェルを経由しない
# 実行でも効かせるため)、両方ある場合はこの環境変数が優先される。掃除は tf-cache-prune。
export TF_PLUGIN_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/terraform/plugin-cache"

# Golang (go 本体は aqua 管理)
export GOPATH="$HOME/Project"
export GHQ_ROOT="$GOPATH/src"

# JavaFX の SDK。OS で置き場所が違う。
case "$(uname)" in
Darwin) export PATH_TO_FX="/Library/Java/JavaVirtualMachines/javafx-sdk/lib" ;;
Linux) export PATH_TO_FX="/usr/share/openjfx/lib" ;;
esac

# ここから下は PATH の先頭側。~/.local/bin より前に出したいものだけを置く。
# この 4 つは実体が無くても足す（あとから `go install` 等で作られたときに使えるように）。
_path_add "$GOPATH/bin"
# agmsg: Codex monitor モードのシム(~/.agents/bin/codex)を本体 codex(~/.local/bin)より
# 前に置く。delivery.sh set monitor codex 実行時に生成され、未生成でも実害なし。
# 詳細: docs/agmsg-cheatsheet.md の「Codex monitor モード」節。
_path_add "$HOME/.agents/bin"
# Rancher Desktop
_path_add "$HOME/.rd/bin"
# NodeJS (Yarn)
_path_add "$HOME/.yarn/bin"

# portfwd: LC_PORTFWD_HOST は通常 ssh の SetEnv で渡るが、herdr のようにサーバ起動時の
# 環境をペインへ配る multiplexer 越しだと、その変数を引き継がないシェルが起動しうる。
# 値はホストごとに固定なので、変数があれば ~/.config/portfwd/host へ保存し、変数が
# 無ければそこから復元する。普通の ssh セッションが一度あれば、その後は herdr の
# ペインを含む全シェルで復元できる。ssh -G の引数になるため daemon 側と同じ文字種
# のみ許可し、それ以外は保存も復元もしない(非対話シェルでも読まれるため警告は出さない)。
# 書き込みに失敗しても(読み取り専用ホームなど)シェルは継続する。
_portfwd_ok() {
	case "$1" in
	"" | *[!A-Za-z0-9._-]*) return 1 ;;
	esac
	return 0
}
_portfwd_file="${XDG_CONFIG_HOME:-$HOME/.config}/portfwd/host"
if [ -n "${LC_PORTFWD_HOST:-}" ]; then
	if _portfwd_ok "$LC_PORTFWD_HOST"; then
		_portfwd_cur=""
		[ -r "$_portfwd_file" ] && read -r _portfwd_cur <"$_portfwd_file"
		if [ "$_portfwd_cur" != "$LC_PORTFWD_HOST" ]; then
			{
				mkdir -p "$(dirname "$_portfwd_file")" &&
					printf '%s\n' "$LC_PORTFWD_HOST" >"$_portfwd_file"
			} 2>/dev/null
		fi
		unset _portfwd_cur
	fi
elif [ -r "$_portfwd_file" ]; then
	read -r _portfwd_host <"$_portfwd_file"
	if _portfwd_ok "$_portfwd_host"; then
		export LC_PORTFWD_HOST="$_portfwd_host"
	fi
	unset _portfwd_host
fi
unset _portfwd_file

# portfwd: オプトインしたホストへ SSH したセッションでのみ、ブラウザ起動を手元へ転送する。
# LC_PORTFWD_HOST は ssh config の対象 Host ブロックの SetEnv でのみ渡るため、
# 手元の mac の通常シェルでは未設定 → BROWSER を書き換えない。
#
# VSCode Remote 等が既に BROWSER を仕込んでいる場合は上書きしない。あちらは自前の
# ポートフォワードで完結しており、奪うと逆に壊れるため。
if [ -z "${BROWSER:-}" ] && [ -n "${LC_PORTFWD_HOST:-}" ] && [ -x "$HOME/.local/bin/portfwd-open" ]; then
	export BROWSER="$HOME/.local/bin/portfwd-open"
fi

if [ "$_man_was_empty" = 1 ] && [ -n "${MANPATH:-}" ]; then
	MANPATH="$MANPATH:"
	export MANPATH
fi
if [ "$_info_was_empty" = 1 ] && [ -n "${INFOPATH:-}" ]; then
	INFOPATH="$INFOPATH:"
	export INFOPATH
fi
unset _man_was_empty _info_was_empty

export PATH
