{{ if eq .chezmoi.os "windows" -}}
# Registers the portfwd daemon as a Task Scheduler user task.
# No administrator rights required: the task runs as the current user at RunLevel Limited.
#
# This runs on every apply, so a task that has been removed or has stopped comes back. What
# is already registered is compared first, and only a difference re-registers: registering
# tears the daemon down, which drops the relays it is carrying.
#
# This file is ASCII only, comments included. chezmoi writes the rendered script without a
# BOM, and Windows PowerShell 5.1 reads a BOM-less .ps1 using the ANSI code page, which
# corrupts non-ASCII bytes badly enough to break parsing.
$ErrorActionPreference = 'Stop'

$TaskName = 'portfwd'
$Script   = Join-Path $env:USERPROFILE '.local\bin\portfwd'
$Argument = '"{0}" serve' -f $Script

# Stored as the task description, and compared on the next run. The hash of the daemon
# source is part of it because an update that touches only the daemon leaves the command
# line identical, and the running process still has to be replaced.
$Stamp = 'portfwd daemon, registered by 56-portfwd-schtask.ps1. daemon-sha256={{ include "dot_local/bin/executable_portfwd" | sha256sum }}'

Write-Host "`n==> Registering portfwd daemon with Task Scheduler" -ForegroundColor Cyan

# Check for the py launcher before invoking it. Calling a missing command raises
# CommandNotFoundException, a terminating error under $ErrorActionPreference = 'Stop',
# which would stop the script before it can print the guidance below.
#
# Write-Error is deliberately not used here. Under $ErrorActionPreference = 'Stop' it is
# promoted to a script-terminating error, so the following exit 1 would never run and the
# exit code could reach chezmoi as 0. [Console]::Error just writes to stderr without
# terminating, so exit 1 always executes.
if (-not (Get-Command py -ErrorAction SilentlyContinue)) {
    [Console]::Error.WriteLine("Python launcher (py) not found. Install Python with: winget install Python.Python.3.13 --scope user")
    exit 1
}

# Locate pythonw.exe through the py launcher. pythonw runs the daemon without a console window.
$Pythonw = & py -3 -c "import os, sys; print(os.path.join(os.path.dirname(sys.executable), 'pythonw.exe'))" 2>$null
if (-not $Pythonw -or -not (Test-Path $Pythonw)) {
    [Console]::Error.WriteLine("pythonw.exe not found. Install Python with: winget install Python.Python.3.13 --scope user")
    exit 1
}

# Read once and used twice: for the comparison below, and for the stop before re-registering.
# Checking for the task rather than letting a later call fail keeps -ErrorAction
# SilentlyContinue from also swallowing real failures such as access denied or CIM errors.
$ExistingTask = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue

# A task that already carries this stamp and this command line is left alone, so an apply
# that changes nothing costs the daemon nothing. Task Scheduler hands Execute back quoted
# when the path contains a space, so it is compared unquoted.
if ($ExistingTask -and $ExistingTask.Description -eq $Stamp) {
    $Actions = @($ExistingTask.Actions)
    if ($Actions.Count -eq 1 -and
        ([string] $Actions[0].Execute).Trim('"') -eq $Pythonw -and
        ([string] $Actions[0].Arguments) -eq $Argument) {

        # Disabled is somebody's decision, not drift, so it stands. Anything else that is
        # not running is started: that is what brings the daemon back after a crash whose
        # restart count ran out.
        if ($ExistingTask.State -eq 'Disabled') {
            Write-Host "portfwd: the task is disabled, leaving it that way (enable it in Task Scheduler)"
            exit 0
        }
        if ($ExistingTask.State -ne 'Running') {
            Start-ScheduledTask -TaskName $TaskName
            Write-Host "portfwd: task was registered but not running, started it"
            exit 0
        }
        Write-Host "portfwd: task is registered and running"
        exit 0
    }
}

# Principal for the task, in DOMAIN\user form ($env:USERNAME alone is ambiguous).
$UserId = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

$Action = New-ScheduledTaskAction -Execute $Pythonw -Argument $Argument
$Trigger = New-ScheduledTaskTrigger -AtLogOn -User $UserId
$Principal = New-ScheduledTaskPrincipal -UserId $UserId -LogonType Interactive -RunLevel Limited
# RestartInterval has a one minute minimum. RestartCount is finite, so once it is exhausted
# the daemon stays down until the next logon or the next chezmoi apply.
$Settings = New-ScheduledTaskSettingsSet `
    -AllowStartIfOnBatteries `
    -DontStopIfGoingOnBatteries `
    -StartWhenAvailable `
    -MultipleInstances IgnoreNew `
    -RestartInterval (New-TimeSpan -Minutes 1) `
    -RestartCount 99 `
    -ExecutionTimeLimit ([TimeSpan]::Zero)

if ($ExistingTask) {
    Stop-ScheduledTask -TaskName $TaskName

    # Stop-ScheduledTask only requests a stop; it does not wait for the process to exit. If
    # the old pythonw still holds the port, the instance started below fails to listen and
    # exits immediately, leaving the daemon down until the one minute restart interval.
    # Wait up to 10 seconds for the task to leave the Running state.
    $WaitedSeconds = 0
    while ((Get-ScheduledTask -TaskName $TaskName).State -eq 'Running' -and $WaitedSeconds -lt 10) {
        Start-Sleep -Milliseconds 500
        $WaitedSeconds += 0.5
    }
    if ((Get-ScheduledTask -TaskName $TaskName).State -eq 'Running') {
        Write-Warning "portfwd task did not stop within 10 seconds; continuing anyway"
    }
}

# Register alone would leave a running instance in place, and MultipleInstances=IgnoreNew
# would make the following Start a no-op, so the old code would keep running. The Stop above
# (and the wait for it) is what makes an update take effect.
Register-ScheduledTask -TaskName $TaskName -Action $Action -Trigger $Trigger `
    -Principal $Principal -Settings $Settings -Description $Stamp -Force | Out-Null
Start-ScheduledTask -TaskName $TaskName

Write-Host "portfwd: task registered ($TaskName / $UserId)"
{{- end }}
