# chezmoi 本体の設定。`chezmoi init` 時に ~/.config/chezmoi/chezmoi.toml へ展開される。
#
# work 環境の識別子（サーバのインスタンス ID / ユーザ名 / uid / AWS プロファイル / GitHub
# Enterprise のホスト名）は、このリポジトリが公開なのでソースへ書かず、ここ（リポジトリ外の生成物）へ置く。
# 参照するのは private_dot_ssh/private_config.tmpl。値が無ければ work 向けの Host 定義ごと
# 出力しないので、work を使わないマシンでは空のままでよい。
# promptStringOnce なので、一度答えれば `chezmoi init` を再実行しても聞かれない。

{{- $workUser := promptStringOnce . "work.user" "work サーバのユーザ名（使わないなら空のまま Enter）" "" }}
{{- $workInstance := promptStringOnce . "work.instance" "work サーバのインスタンス ID" "" }}
{{- $workUid := promptStringOnce . "work.uid" "work サーバでの uid" "" }}
{{- $workProfile := promptStringOnce . "work.profile" "work サーバへ ssh するときの AWS プロファイル" "" }}
{{- $workGhe := promptStringOnce . "work.ghe" "work 用 GitHub Enterprise のホスト名" "" }}
{{- $workBedrock := promptStringOnce . "work.bedrock" "Bedrock を呼ぶときの AWS プロファイル" "" }}

# git の identity。ユーザごとに答える（既定は dotfiles 作者の値）。
# signingkey は SSH 公開鍵の文字列。空なら署名しない（dot_gitconfig.tmpl が gpgsign ごと省く）。
{{- $gitName := promptStringOnce . "git.name" "git の名前" "AkashiSN" }}
{{- $gitEmail := promptStringOnce . "git.email" "git のメールアドレス" "btorntireinvynriy@gmail.com" }}
{{- $gitSigningkey := promptStringOnce . "git.signingkey" "git の署名鍵（SSH 公開鍵。署名しないなら空）" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICnhzqXkGkWLreU4JcDWCAH+8P47Sj5a2iMPCEZa4sip" }}

# 個人のホストと鍵（AkashiSN）を使うか。false なら private_dot_ssh/private_config.tmpl が
# 個人の Host 定義と IdentityFile を出さず、.chezmoiignore が個人の鍵・署名者ファイルを除外する。
{{- $personal := promptBoolOnce . "personal" "個人のホストと鍵（AkashiSN）を使うか" true }}

# umask を固定する。固定しないと chezmoi は実行時シェルの umask を使い、
# 通常ファイル=0666&^umask / 実行ファイル・ディレクトリ=0777&^umask で目標モードを計算する。
# 固定しないと同じ内容でもモードだけ 666/777 に変わり chezmoi diff に差分が出る。
umask = 0o022

# .chezmoiscripts の .ps1 を実行するためのインタプリタ。
# -NoProfile は PowerShell Profile の副作用を避けるため、
# -ExecutionPolicy Bypass はプロセススコープなので管理者権限を必要としない。
[interpreters.ps1]
command = "powershell"
args = ["-NoProfile", "-ExecutionPolicy", "Bypass"]

[data]
personal = {{ $personal }}
{{ if $workUser }}
[data.work]
user = "{{ $workUser }}"
instance = "{{ $workInstance }}"
uid = "{{ $workUid }}"
profile = "{{ $workProfile }}"
ghe = "{{ $workGhe }}"
bedrock = "{{ $workBedrock }}"
{{- end }}

[data.git]
name = {{ $gitName | quote }}
email = {{ $gitEmail | quote }}
signingkey = {{ $gitSigningkey | quote }}
